---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import LiteratureSchemeNav from '../../../components/LiteratureSchemeNav.astro';
import { literatureBooks, literatureEssays, type BookItem, type EssayItem } from '../../../data/literature';

type UnifiedItem = 
  | { kind: 'book'; data: BookItem; sortYear: string }
  | { kind: 'essay'; data: EssayItem; sortYear: string };

const unifiedItems: UnifiedItem[] = [
  ...literatureBooks.map((b) => ({ kind: 'book' as const, data: b, sortYear: String(b.readYear || b.year) })),
  ...literatureEssays.map((e) => ({ kind: 'essay' as const, data: e, sortYear: e.date.slice(0, 4) })),
].sort((a, b) => b.sortYear.localeCompare(a.sortYear));
---

<Layout
  title="Split Atelier · Literature · Marginalia · Yi Wang"
  description="Desktop split-screen reading atelier: left index navigation, right reading canvas."
  isHome={false}
  fullWidth={true}
>
  <Header activeTab="marginalia" />

  <div class="max-w-[1760px] mx-auto w-full pb-20 pt-4 sm:pt-6 px-4 sm:px-8 md:px-12">
    <LiteratureSchemeNav activeScheme="split" />

    <div class="mt-6 sm:mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <aside class="lg:col-span-4 xl:col-span-4 flex flex-col space-y-4 border-b lg:border-b-0 lg:border-r border-[#EFEFEF] pb-8 lg:pb-0 lg:pr-8">
        <div class="flex items-center gap-4 text-[0.66rem] sm:text-[0.72rem] font-mono uppercase tracking-widest text-[#888888] select-none pb-2 border-b border-[#F0F0F0]">
          <button type="button" class="filter-btn active-filter text-black font-bold cursor-pointer" data-filter="all">
            ALL ({unifiedItems.length})
          </button>
          <span>·</span>
          <button type="button" class="filter-btn hover:text-black transition-colors cursor-pointer" data-filter="book">
            BOOKS ({literatureBooks.length})
          </button>
          <span>·</span>
          <button type="button" class="filter-btn hover:text-black transition-colors cursor-pointer" data-filter="essay">
            ESSAYS ({literatureEssays.length})
          </button>
        </div>

        <div class="space-y-2 max-h-[calc(100vh-250px)] overflow-y-auto pr-2" style="scrollbar-gutter: stable;">
          {unifiedItems.map((item, idx) => {
            const isBook = item.kind === 'book';
            const id = item.data.id;
            const title = item.data.title;
            const sub = isBook ? `${item.data.author} · ${item.data.publisher}` : `${item.data.date}`;
            const hasReview = isBook ? !!item.data.review : true;
            return (
              <div
                class={`index-item p-3 rounded-[2px] cursor-pointer transition-all duration-200 select-none group border-l-2 ${
                  idx === 0
                    ? 'active-item bg-[#F9F9F8] border-black text-black'
                    : 'border-transparent hover:bg-[#FAFAFA] text-[#555555]'
                }`}
                data-kind={item.kind}
                data-id={id}
                data-payload={JSON.stringify(item)}
              >
                <div class="flex items-center justify-between text-[0.6rem] font-mono tracking-wider text-[#999999] uppercase mb-1">
                  <span class="font-bold">{isBook ? 'BOOK' : 'ESSAY'}</span>
                  <span>{item.sortYear}</span>
                </div>
                <h4
                  class="text-[0.84rem] sm:text-[0.88rem] font-medium group-hover:text-black transition-colors line-clamp-2 leading-snug"
                  style="font-family: 'Montserrat', sans-serif;"
                >
                  {title}
                </h4>
                <div class="flex items-center justify-between pt-1.5 text-[0.7rem] text-[#777777] font-light">
                  <span class="truncate">{sub}</span>
                  {hasReview && isBook && (
                    <span class="text-[0.62rem] font-mono uppercase tracking-widest text-[#222222] ml-2 shrink-0">
                      ★ REVIEW
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </aside>

      <section class="lg:col-span-8 xl:col-span-8 min-h-[550px] relative select-text pl-0 lg:pl-2">
        <div id="stage-reading-canvas" class="w-full transition-all duration-250 ease-out opacity-100 transform-gpu">
          <div id="canvas-content-slot" class="space-y-8"></div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import type { BookItem, EssayItem } from '../../../data/literature';

  type UnifiedItem = 
    | { kind: 'book'; data: BookItem; sortYear: string }
    | { kind: 'essay'; data: EssayItem; sortYear: string };

  const indexItems = document.querySelectorAll<HTMLElement>('.index-item');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const canvasSlot = document.getElementById('canvas-content-slot');
  const canvasStage = document.getElementById('stage-reading-canvas');

  let currentActiveItem: HTMLElement | null = indexItems[0] || null;

  function renderBookCanvas(book: BookItem) {
    if (!canvasSlot) return;

    let reviewHtml = '';
    if (book.review) {
      const paragraphs = book.review.content.trim().split(/\n\s*\n/).map(p => p.trim()).filter(p => p.length > 0);
      reviewHtml = paragraphs
        .map(p => `<p class="leading-[1.95] text-[0.88rem] sm:text-[0.92rem] text-[#333333] font-normal tracking-wide whitespace-pre-line pt-3" style="text-indent: 2em;">${p}</p>`)
        .join('');
    }

    canvasSlot.innerHTML = `
      <div class="border-b border-[#EAEAEA] pb-6 space-y-3">
        <div class="flex items-center gap-3 font-mono text-[0.68rem] text-[#888888] tracking-widest uppercase">
          <span>${book.publisher}</span>
          <span>·</span>
          <span>${book.edition}</span>
          <span>·</span>
          <span>${book.isbn}</span>
        </div>
        <h1
          class="text-2xl sm:text-3xl font-bold text-[#1E1E1E] leading-tight"
          style="font-family: 'Josefin Sans', sans-serif;"
        >
          ${book.title}
        </h1>
        ${book.originalTitle && book.originalTitle !== book.title ? `<p class="text-[0.88rem] text-[#777777] italic font-serif">${book.originalTitle}</p>` : ''}
        <div class="pt-1 flex items-center gap-6 text-[0.8rem] text-[#555555] flex-wrap">
          <div><strong class="text-black font-medium font-mono text-[0.7rem] uppercase mr-1">AUTHOR:</strong> ${book.author} ${book.translator ? `(${book.translator} 译)` : ''}</div>
          ${book.rating ? `<div><strong class="text-black font-medium font-mono text-[0.7rem] uppercase mr-1">RATING:</strong> <span class="font-mono text-black font-bold">${book.rating}</span></div>` : ''}
          ${book.readYear ? `<div><strong class="text-black font-medium font-mono text-[0.7rem] uppercase mr-1">READ IN:</strong> <span class="font-mono">${book.readYear}</span></div>` : ''}
          <a href="${book.worldcatUrl}" target="_blank" rel="noopener noreferrer" class="text-[#777777] hover:text-black font-mono text-[0.72rem] tracking-wider uppercase underline underline-offset-4">WORLDCAT (OCLC) ↗</a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start pt-2">
        <div class="md:col-span-4 space-y-4">
          <div class="w-full max-w-[220px] aspect-[1/1.414] bg-[#F2EFE9] rounded-[2px] overflow-hidden shadow-md relative mx-auto md:mx-0">
            <div class="absolute left-0 top-0 bottom-0 w-[5px] bg-gradient-to-r from-black/30 via-black/10 to-transparent z-10 pointer-events-none"></div>
            <img src="${book.coverUrl}" alt="${book.title}" class="w-full h-full object-cover" />
          </div>
          ${book.quote ? `
            <blockquote class="italic text-[0.82rem] text-[#555555] font-light pl-3 border-l-2 border-black/70 my-2 leading-relaxed">
              ${book.quote}
            </blockquote>
          ` : ''}
        </div>

        <div class="md:col-span-8 space-y-6">
          <div class="space-y-2">
            <h3 class="text-[0.75rem] uppercase font-mono tracking-widest text-[#888888]">SYNOPSIS & SPECS</h3>
            <p class="text-[0.86rem] text-[#444444] font-light leading-relaxed">${book.summary}</p>
            ${book.specs ? `<p class="text-[0.76rem] text-[#888888] font-mono">${book.specs}</p>` : ''}
          </div>

          ${book.review ? `
            <div class="pt-4 border-t border-[#F0F0F0] space-y-3">
              <div class="flex items-baseline justify-between">
                <h3 class="text-[0.75rem] uppercase font-mono tracking-widest text-black font-bold">CRITICAL ESSAY</h3>
                <span class="text-[0.68rem] font-mono text-[#888888]">${book.review.date}</span>
              </div>
              ${book.review.title ? `<h2 class="text-xl font-bold text-[#1E1E1E]" style="font-family: 'Josefin Sans', sans-serif;">${book.review.title}</h2>` : ''}
              ${book.review.quote ? `<p class="italic text-[0.85rem] text-[#666666]">${book.review.quote}</p>` : ''}
              <div class="pt-1">${reviewHtml}</div>
            </div>
          ` : `
            <div class="pt-8 text-center text-[0.8rem] font-mono text-[#AAAAAA] italic">
              — Personal reading archive note logged without extended essay —
            </div>
          `}
        </div>
      </div>
    `;
  }

  function renderEssayCanvas(essay: EssayItem) {
    if (!canvasSlot) return;

    const paragraphs = essay.content.trim().split(/\n\s*\n/).map(p => p.trim()).filter(p => p.length > 0);
    const contentHtml = paragraphs
      .map(p => `<p class="leading-[2.0] text-[0.92rem] sm:text-[0.98rem] text-[#2E2E2E] font-normal tracking-wide whitespace-pre-line pt-4" style="text-indent: 2em;">${p}</p>`)
      .join('');

    canvasSlot.innerHTML = `
      <article class="max-w-2xl space-y-6">
        <div class="border-b border-[#EAEAEA] pb-6 space-y-3">
          <div class="flex items-center gap-3 font-mono text-[0.68rem] text-[#888888] tracking-widest uppercase">
            <span>ESSAY</span>
            <span>·</span>
            <span>${essay.date}</span>
          </div>

          <h1
            class="text-2xl sm:text-3xl font-bold text-[#1E1E1E] leading-tight"
            style="font-family: 'Josefin Sans', sans-serif;"
          >
            ${essay.title}
          </h1>

          ${essay.subtitle ? `<p class="text-[0.92rem] text-[#666666] font-light italic font-serif leading-relaxed">${essay.subtitle}</p>` : ''}
        </div>

        <div class="pt-2">
          ${contentHtml}
        </div>
      </article>
    `;
  }

  function selectItem(itemEl: HTMLElement) {
    if (!canvasStage || !itemEl) return;
    const payloadStr = itemEl.dataset.payload;
    if (!payloadStr) return;

    const parsed: UnifiedItem = JSON.parse(payloadStr);

    indexItems.forEach((el) => {
      el.classList.remove('active-item', 'bg-[#F9F9F8]', 'border-black', 'text-black');
      el.classList.add('border-transparent', 'text-[#555555]');
    });
    itemEl.classList.add('active-item', 'bg-[#F9F9F8]', 'border-black', 'text-black');
    itemEl.classList.remove('border-transparent', 'text-[#555555]');

    canvasStage.classList.add('opacity-0', 'scale-[0.99]');
    setTimeout(() => {
      if (parsed.kind === 'book') {
        renderBookCanvas(parsed.data);
      } else {
        renderEssayCanvas(parsed.data);
      }
      canvasStage.classList.remove('opacity-0', 'scale-[0.99]');
    }, 150);
  }

  indexItems.forEach((item) => {
    item.addEventListener('click', () => selectItem(item));
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      filterBtns.forEach((b) => {
        b.classList.remove('text-black', 'font-bold');
        b.classList.add('hover:text-black');
      });
      btn.classList.add('text-black', 'font-bold');
      btn.classList.remove('hover:text-black');

      let firstVisible: HTMLElement | null = null;
      indexItems.forEach((item) => {
        const kind = item.dataset.kind;
        if (filter === 'all' || kind === filter) {
          item.classList.remove('hidden');
          if (!firstVisible) firstVisible = item;
        } else {
          item.classList.add('hidden');
        }
      });

      if (firstVisible) {
        selectItem(firstVisible);
      }
    });
  });

  if (currentActiveItem) {
    selectItem(currentActiveItem);
  }
</script>
