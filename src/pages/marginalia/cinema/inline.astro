---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import CinemaSchemeNav from '../../../components/CinemaSchemeNav.astro';
import { cinemaFilms, cinemaSeries, allCinemaItems } from '../../../data/cinema';

const reviewedCount = allCinemaItems.filter(i => !!i.review).length;
---

<Layout
  title="Cinema (Inline Expand) · Marginalia · Yi Wang"
  description="In-place expandable curatorial poster gallery."
  isHome={false}
>
  <Header activeTab="marginalia" />

  <div class="max-w-5xl mx-auto w-full pb-20 pt-1 sm:pt-2">
    <!-- Sub Navigation Scheme Switcher -->
    <CinemaSchemeNav currentScheme="c" />

    <!-- Editorial Header -->
    <header class="text-left space-y-2 pt-2 pb-8 select-none">
      <div>
        <h1
          class="text-[1.75rem] sm:text-[2.2rem] font-bold uppercase tracking-[0.25rem] text-[#2A2A2A]"
          style="font-family: 'Josefin Sans', sans-serif;"
        >
          CINEMA
        </h1>
      </div>

      <p
        class="text-[0.84rem] sm:text-[0.92rem] text-[#666666] font-light tracking-[0.02rem] max-w-2xl leading-relaxed"
        style="font-family: 'Montserrat', sans-serif;"
      >
        Click any film or television series to expand its curatorial folio inline below.
        Browse standard specs with external database links, or unpack full personal reviews in place.
      </p>

      <!-- Category & Review Filter Bar -->
      <div class="pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-[#EFEFEF] pb-4">
        <!-- Media Category: Films vs Series -->
        <div class="flex items-center gap-4 text-[0.68rem] sm:text-[0.74rem] uppercase tracking-[0.18rem]" style="font-family: 'Montserrat', sans-serif;">
          <button
            type="button"
            class="inline-filter-media-btn cursor-pointer py-1 font-bold text-black transition-colors"
            data-media-filter="all"
          >
            ALL <span class="font-mono text-[0.65rem] text-[#888888]">({allCinemaItems.length})</span>
          </button>
          <span class="text-[#D8D8D8] select-none">·</span>
          <button
            type="button"
            class="inline-filter-media-btn cursor-pointer py-1 font-medium text-[#777777] hover:text-black transition-colors"
            data-media-filter="films"
          >
            FILMS <span class="font-mono text-[0.65rem] text-[#888888]">({cinemaFilms.length})</span>
          </button>
          <span class="text-[#D8D8D8] select-none">·</span>
          <button
            type="button"
            class="inline-filter-media-btn cursor-pointer py-1 font-medium text-[#777777] hover:text-black transition-colors"
            data-media-filter="series"
          >
            SERIES <span class="font-mono text-[0.65rem] text-[#888888]">({cinemaSeries.length})</span>
          </button>
        </div>

        <!-- Review State Filter -->
        <div class="flex items-center gap-3 text-[0.68rem] sm:text-[0.74rem] uppercase tracking-[0.16rem]" style="font-family: 'Montserrat', sans-serif;">
          <span class="text-[#A0A0A0] text-[0.6rem] tracking-[0.12rem]">FILTER:</span>
          <button
            type="button"
            class="inline-filter-review-btn cursor-pointer py-1 font-bold text-black transition-colors"
            data-review-filter="all"
          >
            ALL WORKS
          </button>
          <span class="text-[#D8D8D8] select-none">·</span>
          <button
            type="button"
            class="inline-filter-review-btn cursor-pointer py-1 font-medium text-[#777777] hover:text-black transition-colors"
            data-review-filter="with-review"
          >
            WITH REVIEWS <span class="font-mono text-[0.65rem] text-[#888888]">({reviewedCount})</span>
          </button>
        </div>
      </div>
    </header>

    <!-- INLINE FOLIO DRAWER CONTAINER (Dynamically injected / expanded) -->
    <div
      id="inline-folio-tray"
      class="hidden w-full bg-[#FBFBFB] rounded-[2px] p-6 sm:p-10 mb-10 transition-all duration-400 ease-out border-y border-[#EAEAEA] relative"
    >
      <button
        id="inline-tray-close-btn"
        type="button"
        class="absolute top-4 right-4 sm:top-6 sm:right-6 text-[0.7rem] sm:text-[0.74rem] text-[#888888] hover:text-black uppercase tracking-[0.14rem] cursor-pointer"
        style="font-family: 'Montserrat', sans-serif;"
      >
        ✕ COLLAPSE FOLIO
      </button>

      <div id="inline-tray-content" class="w-full"></div>
    </div>

    <!-- MAIN GALLERY -->
    <main class="space-y-14">
      <!-- 1. FEATURE FILMS SECTION -->
      <section id="inline-section-films" class="space-y-6">
        <div class="flex items-baseline justify-between">
          <div class="space-y-0.5">
            <h2
              class="text-[0.92rem] sm:text-[1.05rem] font-bold uppercase tracking-[0.2rem] text-[#222222]"
              style="font-family: 'Josefin Sans', sans-serif;"
            >
              § 01 FEATURE FILMS · 电影
            </h2>
            <p class="text-[0.68rem] text-[#888888] tracking-[0.08rem] uppercase" style="font-family: 'Montserrat', sans-serif;">
              Auteur cinematic masterworks & reflections
            </p>
          </div>
          <span class="font-mono text-[0.68rem] text-[#999999] tracking-wider">
            {cinemaFilms.length} TITLES
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 sm:gap-x-6 gap-y-8 sm:gap-y-10">
          {cinemaFilms.map((film) => (
            <div
              class="inline-card group cursor-pointer flex flex-col select-none"
              data-item-id={film.id}
              data-type="film"
              data-has-review={film.review ? 'true' : 'false'}
              data-item-json={JSON.stringify(film)}
            >
              <div class="relative w-full aspect-[2/3] bg-[#F2F2F2] overflow-hidden rounded-[2px] transition-transform duration-300 group-hover:scale-[1.015]">
                <img src={film.posterUrl} alt={film.title} loading="lazy" class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-95" />
                {film.review && (
                  <div class="absolute top-2 right-2 bg-black/75 backdrop-blur-xs text-white text-[0.52rem] font-mono tracking-[0.12rem] uppercase px-1.5 py-0.5 rounded-[1px]">
                    ESSAY
                  </div>
                )}
              </div>

              <div class="pt-2.5 space-y-0.5 text-left">
                <h3 class="text-[0.78rem] sm:text-[0.84rem] font-medium text-[#2A2A2A] group-hover:text-black transition-colors truncate" style="font-family: 'Montserrat', sans-serif;">
                  {film.chineseTitle ? `${film.title} · ${film.chineseTitle}` : film.title}
                </h3>
                <div class="text-[0.64rem] sm:text-[0.68rem] text-[#777777] tracking-[0.06rem] truncate flex items-center gap-1.5" style="font-family: 'Montserrat', sans-serif;">
                  <span>{film.year}</span>
                  <span class="text-[#C8C8C8]">·</span>
                  <span class="truncate">{film.director.split('(')[0].trim()}</span>
                  {film.review && (
                    <>
                      <span class="text-[#C8C8C8]">·</span>
                      <span class="text-black font-semibold">REVIEW</span>
                    </>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 2. TELEVISION & SERIES SECTION -->
      <section id="inline-section-series" class="space-y-6 pt-4">
        <div class="flex items-baseline justify-between">
          <div class="space-y-0.5">
            <h2
              class="text-[0.92rem] sm:text-[1.05rem] font-bold uppercase tracking-[0.2rem] text-[#222222]"
              style="font-family: 'Josefin Sans', sans-serif;"
            >
              § 02 TELEVISION & SERIES · 电视剧
            </h2>
            <p class="text-[0.68rem] text-[#888888] tracking-[0.08rem] uppercase" style="font-family: 'Montserrat', sans-serif;">
              Anthologies, mini-series & long-form narrative arcs
            </p>
          </div>
          <span class="font-mono text-[0.68rem] text-[#999999] tracking-wider">
            {cinemaSeries.length} TITLES
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 sm:gap-x-6 gap-y-8 sm:gap-y-10">
          {cinemaSeries.map((series) => (
            <div
              class="inline-card group cursor-pointer flex flex-col select-none"
              data-item-id={series.id}
              data-type="series"
              data-has-review={series.review ? 'true' : 'false'}
              data-item-json={JSON.stringify(series)}
            >
              <div class="relative w-full aspect-[2/3] bg-[#F2F2F2] overflow-hidden rounded-[2px] transition-transform duration-300 group-hover:scale-[1.015]">
                <img src={series.posterUrl} alt={series.title} loading="lazy" class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-95" />
                {series.review && (
                  <div class="absolute top-2 right-2 bg-black/75 backdrop-blur-xs text-white text-[0.52rem] font-mono tracking-[0.12rem] uppercase px-1.5 py-0.5 rounded-[1px]">
                    ESSAY
                  </div>
                )}
              </div>

              <div class="pt-2.5 space-y-0.5 text-left">
                <h3 class="text-[0.78rem] sm:text-[0.84rem] font-medium text-[#2A2A2A] group-hover:text-black transition-colors truncate" style="font-family: 'Montserrat', sans-serif;">
                  {series.chineseTitle ? `${series.title} · ${series.chineseTitle}` : series.title}
                </h3>
                <div class="text-[0.64rem] sm:text-[0.68rem] text-[#777777] tracking-[0.06rem] truncate flex items-center gap-1.5" style="font-family: 'Montserrat', sans-serif;">
                  <span>{series.year}</span>
                  <span class="text-[#C8C8C8]">·</span>
                  <span class="truncate">{series.director.split('(')[0].trim()}</span>
                  {series.review && (
                    <>
                      <span class="text-[#C8C8C8]">·</span>
                      <span class="text-black font-semibold">REVIEW</span>
                    </>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>

    <!-- Empty State -->
    <div id="inline-empty-state" class="hidden py-24 text-center space-y-2">
      <p class="text-[0.85rem] text-[#888888] font-light italic" style="font-family: 'Montserrat', sans-serif;">
        No titles match the selected criteria.
      </p>
    </div>
  </div>
</Layout>

<script>
  import type { MediaItem } from '../../../data/cinema';

  let activeMediaFilter: 'all' | 'films' | 'series' = 'all';
  let activeReviewFilter: 'all' | 'with-review' = 'all';

  const mediaFilterBtns = document.querySelectorAll<HTMLButtonElement>('.inline-filter-media-btn');
  const reviewFilterBtns = document.querySelectorAll<HTMLButtonElement>('.inline-filter-review-btn');
  const inlineCards = document.querySelectorAll<HTMLElement>('.inline-card');
  const sectionFilms = document.getElementById('inline-section-films');
  const sectionSeries = document.getElementById('inline-section-series');
  const emptyState = document.getElementById('inline-empty-state');

  const folioTray = document.getElementById('inline-folio-tray');
  const folioContent = document.getElementById('inline-tray-content');
  const folioCloseBtn = document.getElementById('inline-tray-close-btn');

  function renderInlineFolio(item: MediaItem) {
    if (!folioTray || !folioContent) return;

    const hasReview = !!item.review;

    folioContent.innerHTML = `
      <div class="flex flex-col md:flex-row items-start gap-8 text-left" style="font-family: 'Montserrat', sans-serif;">
        <!-- Left: Poster + Rating -->
        <div class="w-full md:w-[200px] shrink-0 space-y-3">
          <div class="w-full aspect-[2/3] bg-[#EFEFEF] rounded-[2px] overflow-hidden shadow-sm">
            <img src="${item.posterUrl}" alt="${item.title}" class="w-full h-full object-cover" />
          </div>
          ${
            hasReview
              ? `
            <div class="text-center">
              <div class="text-[1.05rem] font-bold font-mono text-black">${item.review?.rating}</div>
              <div class="text-[0.58rem] font-mono text-[#888888] tracking-widest uppercase">CRITICAL RATING</div>
            </div>
          `
              : ''
          }
        </div>

        <!-- Right: Specs, Synopsis & Full Review -->
        <div class="flex-1 space-y-4">
          <div class="space-y-1">
            <div class="text-[0.65rem] font-mono tracking-[0.16rem] uppercase text-[#888888]">
              ${item.type === 'film' ? 'FEATURE FILM' : 'TELEVISION & SERIES'} · ${item.year} · ${item.country}
            </div>
            <h3 class="text-[1.35rem] sm:text-[1.6rem] font-bold text-[#222222] tracking-[0.03rem]" style="font-family: 'Josefin Sans', sans-serif;">
              ${item.title}
            </h3>
            ${
              item.chineseTitle || item.originalTitle
                ? `
              <div class="text-[0.8rem] text-[#666666]">
                ${item.chineseTitle || ''} ${item.originalTitle && item.originalTitle !== item.title ? `· ${item.originalTitle}` : ''}
              </div>
            `
                : ''
            }
          </div>

          <div class="space-y-1 text-[0.75rem] text-[#555555]">
            <div><span class="text-[#999999] uppercase text-[0.64rem] tracking-wider">Director:</span> <strong class="text-black font-medium">${item.director}</strong></div>
            <div><span class="text-[#999999] uppercase text-[0.64rem] tracking-wider">Genre:</span> ${item.genre}</div>
            ${item.runtime ? `<div><span class="text-[#999999] uppercase text-[0.64rem] tracking-wider">Runtime:</span> ${item.runtime}</div>` : ''}
            ${item.format ? `<div><span class="text-[#999999] uppercase text-[0.64rem] tracking-wider">Specs:</span> ${item.format}</div>` : ''}
          </div>

          <p class="text-[0.78rem] text-[#666666] font-light leading-relaxed">
            ${item.summary}
          </p>

          ${
            hasReview
              ? `
            <div class="pt-4 border-t border-[#EAEAEA] space-y-3">
              ${
                item.review?.quote
                  ? `
                <blockquote class="italic text-[0.85rem] text-[#333333] font-light pl-3 border-l-2 border-black/80">
                  ${item.review.quote}
                </blockquote>
              `
                  : ''
              }
              <div class="space-y-1.5">
                <span class="text-[0.62rem] font-mono uppercase tracking-[0.16rem] text-[#888888] block">
                  PERSONAL REVIEW ${item.review?.date ? `· ${item.review.date}` : ''}
                </span>
                <p class="text-[0.82rem] sm:text-[0.86rem] text-[#333333] font-light leading-[1.8] tracking-wide whitespace-pre-line">
                  ${item.review?.content}
                </p>
              </div>
            </div>
          `
              : ''
          }

          <div class="pt-3 border-t border-[#EAEAEA]">
            <a
              href="${item.externalLink.url}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[0.74rem] font-bold text-black tracking-[0.14rem] uppercase hover:opacity-60 transition-opacity"
            >
              <span>OPEN ON ${item.externalLink.platform.toUpperCase()}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    `;

    folioTray.classList.remove('hidden');
    folioTray.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function collapseFolio() {
    if (!folioTray) return;
    folioTray.classList.add('hidden');
  }

  folioCloseBtn?.addEventListener('click', collapseFolio);

  inlineCards.forEach((card) => {
    card.addEventListener('click', () => {
      const json = card.dataset.itemJson;
      if (!json) return;
      try {
        const item: MediaItem = JSON.parse(json);
        renderInlineFolio(item);
      } catch (e) {
        console.error(e);
      }
    });
  });

  // Filter application
  function applyInlineFilters() {
    let filmsVisible = 0;
    let seriesVisible = 0;

    inlineCards.forEach((card) => {
      const type = card.dataset.type;
      const hasReview = card.dataset.hasReview === 'true';

      const matchMedia = (activeMediaFilter === 'all') || (activeMediaFilter === 'films' && type === 'film') || (activeMediaFilter === 'series' && type === 'series');
      const matchReview = (activeReviewFilter === 'all') || (activeReviewFilter === 'with-review' && hasReview);

      if (matchMedia && matchReview) {
        card.classList.remove('hidden');
        if (type === 'film') filmsVisible++;
        if (type === 'series') seriesVisible++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (sectionFilms) {
      if (activeMediaFilter === 'series' || filmsVisible === 0) sectionFilms.classList.add('hidden');
      else sectionFilms.classList.remove('hidden');
    }
    if (sectionSeries) {
      if (activeMediaFilter === 'films' || seriesVisible === 0) sectionSeries.classList.add('hidden');
      else sectionSeries.classList.remove('hidden');
    }
    if (emptyState) {
      if (filmsVisible === 0 && seriesVisible === 0) emptyState.classList.remove('hidden');
      else emptyState.classList.add('hidden');
    }
  }

  mediaFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      mediaFilterBtns.forEach((b) => {
        b.classList.remove('font-bold', 'text-black');
        b.classList.add('font-medium', 'text-[#777777]');
      });
      btn.classList.remove('font-medium', 'text-[#777777]');
      btn.classList.add('font-bold', 'text-black');
      activeMediaFilter = (btn.dataset.mediaFilter as any) || 'all';
      applyInlineFilters();
    });
  });

  reviewFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      reviewFilterBtns.forEach((b) => {
        b.classList.remove('font-bold', 'text-black');
        b.classList.add('font-medium', 'text-[#777777]');
      });
      btn.classList.remove('font-medium', 'text-[#777777]');
      btn.classList.add('font-bold', 'text-black');
      activeReviewFilter = (btn.dataset.reviewFilter as any) || 'all';
      applyInlineFilters();
    });
  });
</script>
