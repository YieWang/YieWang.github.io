---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import CinemaSchemeNav from '../../../components/CinemaSchemeNav.astro';
import { cinemaFilms, cinemaSeries, allCinemaItems, type MediaItem } from '../../../data/cinema';

const firstItem = allCinemaItems[0];
const reviewedCount = allCinemaItems.filter(i => !!i.review).length;
---

<Layout
  title="Cinema (Split Stage) · Marginalia · Yi Wang"
  description="Dual-panel split interactive cinema curatorial desk."
  isHome={false}
  fullWidth={true}
>
  <Header activeTab="marginalia" />

  <div class="max-w-[1400px] mx-auto w-full px-2 sm:px-6 md:px-8 pb-12 pt-1 sm:pt-2">
    <!-- Sub Navigation Scheme Switcher -->
    <CinemaSchemeNav currentScheme="b" />

    <!-- Split Stage Horizon Root -->
    <div class="w-full flex flex-col lg:flex-row items-stretch gap-6 lg:gap-10 min-h-[calc(100vh-140px)]">
      
      <!-- LEFT PANEL: Poster Wall & Category Filters (Scrollable Horizon) -->
      <aside class="w-full lg:w-[48%] xl:w-[45%] flex-shrink-0 flex flex-col space-y-4">
        
        <!-- Header & Typography Filter Bar -->
        <div class="space-y-3 select-none pb-2 border-b border-[#EFEFEF]">
          <div>
            <h1
              class="text-[1.5rem] sm:text-[1.8rem] font-bold uppercase tracking-[0.2rem] text-[#2A2A2A]"
              style="font-family: 'Josefin Sans', sans-serif;"
            >
              CINEMA
            </h1>
          </div>

          <!-- Filter Controls -->
          <div class="flex items-center justify-between gap-2 flex-wrap text-[0.66rem] sm:text-[0.72rem] uppercase tracking-[0.14rem]" style="font-family: 'Montserrat', sans-serif;">
            <!-- Category -->
            <div class="flex items-center gap-3">
              <button
                type="button"
                class="split-filter-media-btn cursor-pointer font-bold text-black py-0.5"
                data-media-filter="all"
              >
                ALL ({allCinemaItems.length})
              </button>
              <span class="text-[#D8D8D8]">·</span>
              <button
                type="button"
                class="split-filter-media-btn cursor-pointer font-medium text-[#777777] hover:text-black py-0.5"
                data-media-filter="films"
              >
                FILMS ({cinemaFilms.length})
              </button>
              <span class="text-[#D8D8D8]">·</span>
              <button
                type="button"
                class="split-filter-media-btn cursor-pointer font-medium text-[#777777] hover:text-black py-0.5"
                data-media-filter="series"
              >
                SERIES ({cinemaSeries.length})
              </button>
            </div>

            <!-- Review Filter -->
            <div class="flex items-center gap-2">
              <button
                type="button"
                class="split-filter-review-btn cursor-pointer font-bold text-black py-0.5"
                data-review-filter="all"
              >
                ALL
              </button>
              <span class="text-[#D8D8D8]">·</span>
              <button
                type="button"
                class="split-filter-review-btn cursor-pointer font-medium text-[#777777] hover:text-black py-0.5"
                data-review-filter="with-review"
              >
                WITH REVIEWS ({reviewedCount})
              </button>
            </div>
          </div>
        </div>

        <!-- Scrollable Wall Container -->
        <div class="flex-1 overflow-y-auto pr-1 lg:max-h-[calc(100vh-230px)] space-y-8">
          
          <!-- Films Section -->
          <div id="split-section-films" class="space-y-3">
            <div class="text-[0.72rem] font-bold tracking-[0.18rem] uppercase text-[#333333]" style="font-family: 'Josefin Sans', sans-serif;">
              FILMS · 电影长片
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
              {cinemaFilms.map((film) => (
                <div
                  class="split-card group cursor-pointer flex flex-col select-none relative transition-all duration-200"
                  data-item-id={film.id}
                  data-type="film"
                  data-has-review={film.review ? 'true' : 'false'}
                  data-item-json={JSON.stringify(film)}
                >
                  <div class="relative w-full aspect-[2/3] bg-[#EAEAEA] rounded-[2px] overflow-hidden group-hover:opacity-90">
                    <img src={film.posterUrl} alt={film.title} loading="lazy" class="w-full h-full object-cover" />
                    {film.review && (
                      <span class="absolute top-1.5 right-1.5 bg-black/80 text-white text-[0.48rem] font-mono tracking-wider px-1 py-0.2 rounded-[1px]">
                        ESSAY
                      </span>
                    )}
                  </div>
                  <div class="pt-1.5 text-left truncate">
                    <span class="block text-[0.72rem] font-medium text-[#222222] group-hover:text-black truncate" style="font-family: 'Montserrat', sans-serif;">
                      {film.title}
                    </span>
                    <span class="block text-[0.62rem] text-[#888888] font-mono truncate">
                      {film.year} · {film.director.split('(')[0].trim()}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Series Section -->
          <div id="split-section-series" class="space-y-3 pt-2">
            <div class="text-[0.72rem] font-bold tracking-[0.18rem] uppercase text-[#333333]" style="font-family: 'Josefin Sans', sans-serif;">
              SERIES · 电视剧集
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
              {cinemaSeries.map((series) => (
                <div
                  class="split-card group cursor-pointer flex flex-col select-none relative transition-all duration-200"
                  data-item-id={series.id}
                  data-type="series"
                  data-has-review={series.review ? 'true' : 'false'}
                  data-item-json={JSON.stringify(series)}
                >
                  <div class="relative w-full aspect-[2/3] bg-[#EAEAEA] rounded-[2px] overflow-hidden group-hover:opacity-90">
                    <img src={series.posterUrl} alt={series.title} loading="lazy" class="w-full h-full object-cover" />
                    {series.review && (
                      <span class="absolute top-1.5 right-1.5 bg-black/80 text-white text-[0.48rem] font-mono tracking-wider px-1 py-0.2 rounded-[1px]">
                        ESSAY
                      </span>
                    )}
                  </div>
                  <div class="pt-1.5 text-left truncate">
                    <span class="block text-[0.72rem] font-medium text-[#222222] group-hover:text-black truncate" style="font-family: 'Montserrat', sans-serif;">
                      {series.title}
                    </span>
                    <span class="block text-[0.62rem] text-[#888888] font-mono truncate">
                      {series.year} · {series.director.split('(')[0].trim()}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Empty State -->
          <div id="split-empty-state" class="hidden py-16 text-center text-[0.78rem] text-[#888888] font-light italic">
            No matching titles.
          </div>
        </div>
      </aside>

      <!-- RIGHT PANEL: Fixed Interactive Curatorial Desk (No Popups, Pure Crossfade) -->
      <main class="flex-1 bg-[#FAFAFA] rounded-[3px] p-6 sm:p-10 flex flex-col justify-start overflow-y-auto lg:max-h-[calc(100vh-140px)] select-text relative">
        <div id="stage-display-container" class="w-full transition-opacity duration-300 opacity-100 space-y-6">
          <!-- Dynamically populated via JS, initialized with firstItem -->
        </div>
      </main>

    </div>
  </div>
</Layout>

<script>
  import { allCinemaItems, type MediaItem } from '../../../data/cinema';

  let currentActiveItem: MediaItem = allCinemaItems[0];
  let activeMedia: 'all' | 'films' | 'series' = 'all';
  let activeReview: 'all' | 'with-review' = 'all';

  const stageContainer = document.getElementById('stage-display-container');
  const splitCards = document.querySelectorAll<HTMLElement>('.split-card');
  const sectionFilms = document.getElementById('split-section-films');
  const sectionSeries = document.getElementById('split-section-series');
  const emptyState = document.getElementById('split-empty-state');

  const mediaBtns = document.querySelectorAll<HTMLButtonElement>('.split-filter-media-btn');
  const reviewBtns = document.querySelectorAll<HTMLButtonElement>('.split-filter-review-btn');

  function renderStage(item: MediaItem) {
    if (!stageContainer) return;

    stageContainer.style.opacity = '0';

    setTimeout(() => {
      const hasReview = !!item.review;

      stageContainer.innerHTML = `
        <!-- Top Title & Format Header -->
        <div class="space-y-1 text-left border-b border-[#EAEAEA] pb-4" style="font-family: 'Montserrat', sans-serif;">
          <div class="flex items-center justify-between text-[0.65rem] font-mono tracking-[0.16rem] uppercase text-[#888888]">
            <span>${item.type === 'film' ? 'FEATURE FILM' : 'TELEVISION & SERIES'} · ${item.year}</span>
            <span>${item.country}</span>
          </div>
          <h2 class="text-[1.5rem] sm:text-[1.85rem] font-bold text-[#222222] tracking-[0.03rem]" style="font-family: 'Josefin Sans', sans-serif;">
            ${item.title}
          </h2>
          ${
            item.chineseTitle || item.originalTitle
              ? `
            <div class="text-[0.82rem] text-[#666666]">
              ${item.chineseTitle || ''} ${item.originalTitle && item.originalTitle !== item.title ? `· ${item.originalTitle}` : ''}
            </div>
          `
              : ''
          }
        </div>

        <!-- Center Image & Meta Block -->
        <div class="flex flex-col md:flex-row items-start gap-6 pt-2">
          <!-- Poster / Still Frame -->
          <div class="w-full md:w-[220px] shrink-0">
            <div class="w-full aspect-[2/3] bg-[#EFEFEF] rounded-[2px] overflow-hidden shadow-sm">
              <img src="${item.posterUrl}" alt="${item.title}" class="w-full h-full object-cover" />
            </div>
            ${
              hasReview
                ? `
              <div class="pt-3 text-center">
                <div class="text-[1.1rem] font-bold font-mono text-black">${item.review?.rating}</div>
                <div class="text-[0.6rem] font-mono text-[#888888] tracking-widest uppercase">PERSONAL RATING</div>
              </div>
            `
                : ''
            }
          </div>

          <!-- Metadata & Synopsis -->
          <div class="flex-1 space-y-4 text-left" style="font-family: 'Montserrat', sans-serif;">
            <div class="space-y-1.5 text-[0.76rem] text-[#555555]">
              <div><span class="text-[#999999] uppercase text-[0.65rem] tracking-wider">Director / Creator:</span> <strong class="text-black font-medium">${item.director}</strong></div>
              <div><span class="text-[#999999] uppercase text-[0.65rem] tracking-wider">Genre:</span> ${item.genre}</div>
              ${item.runtime ? `<div><span class="text-[#999999] uppercase text-[0.65rem] tracking-wider">Runtime:</span> ${item.runtime}</div>` : ''}
              ${item.format ? `<div><span class="text-[#999999] uppercase text-[0.65rem] tracking-wider">Specs:</span> ${item.format}</div>` : ''}
            </div>

            <p class="text-[0.8rem] text-[#666666] font-light leading-relaxed">
              ${item.summary}
            </p>

            <!-- External Direct Link -->
            <div class="pt-2">
              <a
                href="${item.externalLink.url}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-[0.74rem] font-bold text-black tracking-[0.14rem] uppercase hover:opacity-60 transition-opacity"
              >
                <span>OPEN ON ${item.externalLink.platform.toUpperCase()}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Review Section if available -->
        ${
          hasReview
            ? `
          <div class="mt-6 pt-6 border-t border-[#EAEAEA] space-y-4 text-left" style="font-family: 'Montserrat', sans-serif;">
            ${
              item.review?.quote
                ? `
              <blockquote class="italic text-[0.85rem] sm:text-[0.92rem] text-[#333333] font-light pl-4 border-l-2 border-black/80">
                ${item.review.quote}
              </blockquote>
            `
                : ''
            }
            <div class="space-y-2">
              <span class="text-[0.62rem] font-mono uppercase tracking-[0.16rem] text-[#888888] block">
                CRITICAL ESSAY & NOTES ${item.review?.date ? `· ${item.review.date}` : ''}
              </span>
              <p class="text-[0.82rem] sm:text-[0.88rem] text-[#333333] font-light leading-[1.85] tracking-wide whitespace-pre-line">
                ${item.review?.content}
              </p>
            </div>
          </div>
        `
            : ''
        }
      `;

      stageContainer.style.opacity = '1';
    }, 150);
  }

  // Filter application
  function applySplitFilters() {
    let filmsVisible = 0;
    let seriesVisible = 0;

    splitCards.forEach((card) => {
      const type = card.dataset.type;
      const hasReview = card.dataset.hasReview === 'true';

      const matchMedia = (activeMedia === 'all') || (activeMedia === 'films' && type === 'film') || (activeMedia === 'series' && type === 'series');
      const matchReview = (activeReview === 'all') || (activeReview === 'with-review' && hasReview);

      if (matchMedia && matchReview) {
        card.classList.remove('hidden');
        if (type === 'film') filmsVisible++;
        if (type === 'series') seriesVisible++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (sectionFilms) {
      if (activeMedia === 'series' || filmsVisible === 0) sectionFilms.classList.add('hidden');
      else sectionFilms.classList.remove('hidden');
    }
    if (sectionSeries) {
      if (activeMedia === 'films' || seriesVisible === 0) sectionSeries.classList.add('hidden');
      else sectionSeries.classList.remove('hidden');
    }
    if (emptyState) {
      if (filmsVisible === 0 && seriesVisible === 0) emptyState.classList.remove('hidden');
      else emptyState.classList.add('hidden');
    }
  }

  mediaBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      mediaBtns.forEach((b) => {
        b.classList.remove('font-bold', 'text-black');
        b.classList.add('font-medium', 'text-[#777777]');
      });
      btn.classList.remove('font-medium', 'text-[#777777]');
      btn.classList.add('font-bold', 'text-black');
      activeMedia = (btn.dataset.mediaFilter as any) || 'all';
      applySplitFilters();
    });
  });

  reviewBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      reviewBtns.forEach((b) => {
        b.classList.remove('font-bold', 'text-black');
        b.classList.add('font-medium', 'text-[#777777]');
      });
      btn.classList.remove('font-medium', 'text-[#777777]');
      btn.classList.add('font-bold', 'text-black');
      activeReview = (btn.dataset.reviewFilter as any) || 'all';
      applySplitFilters();
    });
  });

  // Card click to load stage
  splitCards.forEach((card) => {
    card.addEventListener('click', () => {
      const json = card.dataset.itemJson;
      if (!json) return;
      try {
        const item: MediaItem = JSON.parse(json);
        renderStage(item);
      } catch (e) {
        console.error(e);
      }
    });
  });

  // Initial render
  renderStage(currentActiveItem);
</script>
