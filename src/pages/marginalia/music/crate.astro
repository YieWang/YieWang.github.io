---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import MusicSchemeNav from '../../../components/MusicSchemeNav.astro';
import { musicAlbums, musicArtists, type MusicAlbum } from '../../../data/music';

// Default initial album is the first one
const initialAlbum = musicAlbums[0];
---

<Layout
  title="The Crate Digger · Music · Yi Wang"
  description="Browsing records like digging in physical vinyl crates with a synchronized listening and review station."
  isHome={false}
  fullWidth={true}
>
  <Header activeTab="marginalia" />

  <div class="max-w-[1760px] mx-auto w-full pb-28 pt-2 sm:pt-4 px-4 sm:px-8 md:px-12">
    <!-- Top Scheme Switcher -->
    <MusicSchemeNav activeScheme="crate" />

    <!-- Station Subtitle & Genre Filter -->
    <div class="pt-4 pb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 select-none">
      <div>
        <h1
          class="text-[1.1rem] sm:text-[1.2rem] font-bold tracking-[0.2rem] uppercase text-[#1E1E1E]"
          style="font-family: 'Josefin Sans', sans-serif;"
        >
          THE CRATE DIGGER
        </h1>
        <p class="text-[0.75rem] text-[#888888] font-mono tracking-wider pt-0.5">
          DESK 01 · PHYSICAL CRATE BROWSING & LINER NOTES WORKBENCH
        </p>
      </div>

      <!-- Genre Filter Pills (Pure Text, No borders) -->
      <div class="flex items-center gap-4 sm:gap-6 flex-wrap font-mono text-[0.72rem] tracking-wider text-[#888888]">
        <button class="crate-filter-btn text-black font-bold cursor-pointer" data-genre="all">
          ALL ({musicAlbums.length})
        </button>
        <button class="crate-filter-btn hover:text-black cursor-pointer" data-genre="Classical">
          CLASSICAL
        </button>
        <button class="crate-filter-btn hover:text-black cursor-pointer" data-genre="Ambient">
          AMBIENT
        </button>
        <button class="crate-filter-btn hover:text-black cursor-pointer" data-genre="Jazz">
          JAZZ
        </button>
        <button class="crate-filter-btn hover:text-black cursor-pointer" data-genre="Art Rock">
          ROCK/POP
        </button>
      </div>
    </div>

    <!-- MAIN CRATE WORKBENCH (Split-screen 2-column) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- LEFT COLUMN: The Crate (Scrollable Records Rack) -->
      <section class="lg:col-span-5 space-y-3">
        <div class="flex items-center justify-between font-mono text-[0.7rem] text-[#888888] uppercase tracking-widest border-b border-[#EAEAEA] pb-2">
          <span>CRATE INVENTORY</span>
          <span>SELECT TO SPIN</span>
        </div>

        <div id="crate-list-container" class="space-y-2.5 max-h-[calc(100vh-210px)] overflow-y-auto pr-2 overscroll-contain">
          {musicAlbums.map((album, idx) => (
            <div
              class={`crate-item group cursor-pointer p-3 sm:p-3.5 rounded-[2px] transition-all duration-200 flex items-center justify-between gap-4 select-none ${
                idx === 0 ? 'bg-black text-white shadow-md active-crate' : 'bg-[#FAFAFA] hover:bg-[#F2F2F2] text-[#222222]'
              }`}
              data-album-id={album.id}
              data-genre={album.genre}
              data-album-json={JSON.stringify(album)}
            >
              <div class="flex items-center gap-3.5 min-w-0">
                <!-- Mini Vinyl Sleeve -->
                <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-[2px] overflow-hidden flex-shrink-0 bg-[#E0E0E0] shadow-sm relative">
                  <img src={album.coverUrl} alt={album.title} class="w-full h-full object-cover" />
                </div>

                <!-- Titles & Meta -->
                <div class="min-w-0 space-y-0.5">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-[0.65rem] tracking-wider opacity-60">
                      #{String(idx + 1).padStart(2, '0')}
                    </span>
                    <span class="font-mono text-[0.65rem] uppercase tracking-wider opacity-60">
                      {album.format}
                    </span>
                  </div>
                  <h3
                    class="text-[0.84rem] sm:text-[0.88rem] font-medium truncate leading-tight"
                    style="font-family: 'Montserrat', sans-serif;"
                  >
                    {album.title}
                  </h3>
                  <p class="text-[0.74rem] opacity-75 truncate font-light">
                    {album.artistName}
                  </p>
                </div>
              </div>

              <!-- Right badge / indicator -->
              <div class="text-right font-mono text-[0.68rem] tracking-wider shrink-0 opacity-70">
                <div>{album.year}</div>
                {album.review && <div class="text-[0.62rem] text-right mt-1">NOTES ★</div>}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- RIGHT COLUMN: The Listening Station & Desk Notebook (Sticky Live View) -->
      <section class="lg:col-span-7 bg-[#FAFAFA] rounded-[3px] p-6 sm:p-8 space-y-6 lg:sticky lg:top-8 border border-[#F0F0F0]">
        
        <!-- Deck Header: Current Spin -->
        <div id="deck-view-slot" class="space-y-6">
          <!-- Initially injected with initialAlbum -->
        </div>

      </section>

    </div>
  </div>
</Layout>

<script>
  import { musicAlbums, type MusicAlbum } from '../../../data/music';

  const crateItems = document.querySelectorAll<HTMLElement>('.crate-item');
  const deckSlot = document.getElementById('deck-view-slot');
  const filterBtns = document.querySelectorAll<HTMLElement>('.crate-filter-btn');

  let currentSelectedId = musicAlbums[0]?.id || '';

  function renderDeck(album: MusicAlbum) {
    if (!deckSlot) return;

    const tracksHtml = album.tracks.map((t) => `
      <div class="py-2 border-b border-[#EDEDED] flex flex-col">
        <div class="flex items-center justify-between text-[0.8rem]">
          <div class="flex items-center gap-3">
            <span class="font-mono text-[0.7rem] text-[#888888] w-4">${String(t.trackNo).padStart(2, '0')}</span>
            <span class="font-medium text-[#222222] ${t.isFavorite ? 'text-black' : ''}">${t.title}</span>
            ${t.isFavorite ? '<span class="text-[0.65rem] text-amber-700">★ FAVORITE</span>' : ''}
          </div>
          <span class="font-mono text-[0.72rem] text-[#888888]">${t.duration}</span>
        </div>
        ${t.note ? `
          <div class="mt-1.5 pl-7 text-[0.75rem] leading-relaxed text-[#555555] bg-white p-2 rounded-[2px] border border-[#F0F0F0]">
            <span class="text-[#888888] font-mono mr-1">TRACK NOTE:</span>${t.note}
          </div>
        ` : ''}
      </div>
    `).join('');

    const reviewHtml = album.review ? `
      <div class="space-y-3.5 bg-white p-5 sm:p-6 rounded-[2px] border border-[#EEEEEE]">
        <div class="flex items-center justify-between border-b border-[#F0F0F0] pb-2 font-mono text-[0.7rem] text-[#888888] uppercase tracking-wider">
          <span>PERSONAL LINER NOTES & IMPRESSION</span>
          <span>DATE: ${album.review.date || album.year}</span>
        </div>
        ${album.review.quote ? `
          <blockquote class="border-l-2 border-black pl-3.5 italic text-[0.88rem] text-[#333333] font-light leading-relaxed">
            "${album.review.quote}"
          </blockquote>
        ` : ''}
        <div class="text-[0.86rem] sm:text-[0.88rem] text-[#333333] leading-[1.9] text-justify whitespace-pre-line" style="text-indent: 2em;">
          ${album.review.content}
        </div>
      </div>
    ` : `
      <div class="bg-white p-6 rounded-[2px] border border-[#EEEEEE] text-center text-[#888888] font-mono text-[0.78rem]">
        NO LINER NOTES ATTACHED YET FOR THIS RECORD
      </div>
    `;

    deckSlot.innerHTML = `
      <!-- Turntable Deck Top Card -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 pb-6 border-b border-[#EAEAEA]">
        <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-[2px] overflow-hidden shadow-lg flex-shrink-0 bg-white relative">
          <img src="${album.coverUrl}" alt="${album.title}" class="w-full h-full object-cover" />
          <div class="absolute bottom-1.5 right-1.5 px-1.5 py-0.5 bg-black/80 text-white font-mono text-[0.6rem] uppercase tracking-wider rounded-[1px]">
            ${album.format}
          </div>
        </div>

        <div class="space-y-1.5 min-w-0">
          <div class="flex items-center gap-2 font-mono text-[0.7rem] text-[#888888] uppercase tracking-widest">
            <span class="w-2 h-2 rounded-full bg-black animate-pulse"></span>
            <span>ON TURNTABLE · ${album.label} ${album.catalogNo ? `[${album.catalogNo}]` : ''}</span>
          </div>

          <h2 class="text-[1.35rem] sm:text-[1.5rem] font-bold text-black tracking-wide leading-tight" style="font-family: 'Josefin Sans', sans-serif;">
            ${album.title}
          </h2>
          <p class="text-[0.88rem] text-[#444444] font-light">
            ${album.artistName} ${album.originalArtistName ? `<span class="text-[#888888]">(${album.originalArtistName})</span>` : ''}
          </p>

          <div class="pt-1 flex items-center gap-4 font-mono text-[0.74rem] text-[#777777]">
            <span>${album.year}</span>
            <span>·</span>
            <span>${album.genre}</span>
            ${album.rating ? `<span>·</span><span class="text-black font-semibold">★ ${album.rating}</span>` : ''}
          </div>
        </div>
      </div>

      <!-- Tracklist Section -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[0.72rem] font-mono tracking-wider text-[#888888] uppercase border-b border-[#EAEAEA] pb-1.5">
          <span>TRACKLIST & SINGLE IMPRESSIONS</span>
          <span>${album.tracks.length} TRACKS</span>
        </div>
        <div class="space-y-1">
          ${tracksHtml}
        </div>
      </div>

      <!-- Liner Notes Section -->
      ${reviewHtml}
    `;
  }

  // Initial render
  const initial = musicAlbums.find(a => a.id === currentSelectedId) || musicAlbums[0];
  if (initial) {
    renderDeck(initial);
  }

  // Crate item clicking
  crateItems.forEach((item) => {
    item.addEventListener('click', () => {
      const albumJson = item.dataset.albumJson;
      const albumId = item.dataset.albumId;
      if (!albumJson || !albumId) return;

      currentSelectedId = albumId;

      // Update active state in crate
      crateItems.forEach(ci => {
        ci.classList.remove('bg-black', 'text-white', 'shadow-md', 'active-crate');
        ci.classList.add('bg-[#FAFAFA]', 'text-[#222222]');
      });
      item.classList.remove('bg-[#FAFAFA]', 'text-[#222222]');
      item.classList.add('bg-black', 'text-white', 'shadow-md', 'active-crate');

      try {
        const album = JSON.parse(albumJson) as MusicAlbum;
        renderDeck(album);
      } catch (e) {
        console.error(e);
      }
    });
  });

  // Filter functionality
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const genre = btn.dataset.genre || 'all';

      filterBtns.forEach(b => {
        b.classList.remove('text-black', 'font-bold');
        b.classList.add('text-[#888888]', 'font-normal');
      });
      btn.classList.add('text-black', 'font-bold');
      btn.classList.remove('text-[#888888]', 'font-normal');

      crateItems.forEach(item => {
        const itemGenre = item.dataset.genre || '';
        if (genre === 'all' || itemGenre.toLowerCase().includes(genre.toLowerCase())) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });
</script>
