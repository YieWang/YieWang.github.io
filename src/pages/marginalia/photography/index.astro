---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import PhotographyWheelPicker from '../../../components/photography/PhotographyWheelPicker';
import { allPhotos, allCityAlbums, photoOptics, photoLocation } from '../../../data/photography';

const firstCity = allCityAlbums[0];
const firstPhoto = firstCity?.photos[0] || allPhotos[0];
---

<Layout
  title="Photography · Yi Wang"
  description="Photographic archive arranged by year and location."
  isHome={false}
  fullWidth={true}
  zeroScroll={true}
>
  <Header activeTab="marginalia" />

  {!firstPhoto && <p class="text-sm text-[#888888] text-center py-16">No photos yet.</p>}
  {firstPhoto && <>
  <!-- Single-Screen Zero-Scroll Gallery Viewport (Desktop 100vh) -->
  <div
    id="gallery-viewport-root"
    class="w-full h-[calc(100dvh-55px)] sm:h-[calc(100dvh-98px)] min-h-[550px] md:h-auto md:min-h-0 md:flex-1 flex items-stretch gap-2 sm:gap-4 md:gap-5 overflow-hidden select-none overscroll-none -ml-1 sm:-ml-2"
  >
    <div id="photo-mobile-heading">
      <select id="photo-year-select" aria-label="拍摄年份">
        {[...new Set(allPhotos.map(photo => photo.year))].map(year => <option value={year} selected={year === firstPhoto.year}>{year}</option>)}
      </select>
      <span id="photo-mobile-city">{firstPhoto.locationEn}</span>
    </div>
    
    <!-- LEFT: iOS 3D Cylindrical Wheel Picker (docked further left) -->
    <aside class="w-[172px] sm:w-[184px] md:w-[190px] flex-shrink-0 h-full flex flex-col relative z-20 pl-0">
      <PhotographyWheelPicker client:load initialPhotoId={firstPhoto.id} />
    </aside>

    <!-- RIGHT: Vast Showcase Stage (Dual-Layer Optical Crossfade Top, Maximized Display Canvas) -->
    <main
      id="right-showcase-stage"
      class="flex-1 h-full flex flex-col justify-between overflow-hidden pr-2 sm:pr-4 md:pr-6 pb-2.5 sm:pb-3.5 md:pb-4"
    >
      
      <!-- TOP: Dual-Layer Optical Morphing Canvas (Clean full-bleed, Zero floating arrows) -->
      <div id="photo-canvas" style={`--photo-aspect: ${firstPhoto.width} / ${firstPhoto.height}`} class="flex-1 min-h-0 w-full flex items-center justify-center p-0.5 sm:p-1 overflow-hidden relative">
        <!-- Layer A -->
        <img
          id="stage-layer-a"
          src={firstPhoto.imageUrl}
          alt={firstPhoto.title}
          class="stage-layer-img absolute max-w-full max-h-full w-auto h-auto object-contain rounded-[2px] opacity-100"
          style="will-change: opacity;"
          decoding="async"
        />
        <!-- Layer B (Dual buffer) -->
        <img
          id="stage-layer-b"
          src=""
          alt=""
          class="stage-layer-img absolute max-w-full max-h-full w-auto h-auto object-contain rounded-[2px] opacity-0 pointer-events-none"
          style="will-change: opacity;"
          decoding="async"
        />
      </div>

      <div id="photo-mobile-thumbnails" aria-label="照片列表">
        {allPhotos.map((photo, index) => (
          <button type="button" data-photo-index={index} aria-label={`${photo.year} ${photo.locationEn} ${photo.title}`} aria-pressed={photo.id === firstPhoto.id}>
            <img src={photo.thumbnailUrl} alt="" width={photo.width} height={photo.height} loading="lazy" decoding="async" />
          </button>
        ))}
      </div>

      <!-- BOTTOM: Dedicated Typography Space (Fixed-Height Envelope to Prevent Stage Layout Shift) -->
      <footer
        id="bottom-meta-footer"
        class="w-full flex-shrink-0 h-[64px] sm:h-[68px] pt-2.5 sm:pt-3 pb-0.5 px-1 flex items-center justify-between gap-3 sm:gap-4 transition-opacity duration-300 overflow-hidden"
      >
        <!-- LEFT COLUMN: Curatorial Narrative (Title + Location, followed by Story) -->
        <div class="flex-1 min-w-0 flex flex-col justify-center gap-1">
          <!-- Row 1: Title & Location -->
          <div class="flex items-baseline gap-2 min-w-0 truncate">
            <h2
              id="meta-title"
              class="text-[0.98rem] sm:text-[1.12rem] font-bold text-[#2A2A2A] tracking-[0.05rem] shrink-0"
              style="font-family: 'Josefin Sans', sans-serif;"
            >
              {firstPhoto.title}
            </h2>
            <span
              id="meta-location"
              class="text-[0.72rem] sm:text-[0.76rem] text-[#666666] tracking-[0.08rem] uppercase truncate"
              style="font-family: 'Montserrat', sans-serif;"
            >
              {photoLocation(firstPhoto)}
            </span>
          </div>

          <!-- Row 2: Curatorial Story Notes -->
          <p
            id="meta-story"
            class="text-[0.76rem] sm:text-[0.8rem] text-[#666666] font-light tracking-wide truncate italic"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {firstPhoto.story ? `"${firstPhoto.story}"` : ''}
          </p>
        </div>

        <!-- RIGHT COLUMN: Optical Craft Archive (Aligned right, 2 dedicated rows) -->
        <div id="photo-camera-meta" class="shrink-0 flex flex-col justify-center items-end text-right gap-1 font-mono" style={!firstPhoto.camera && !firstPhoto.exif ? 'display: none' : undefined}>
          <!-- Row 1: Camera & Film -->
          <div class="text-[0.68rem] sm:text-[0.72rem] text-[#777777] flex items-center gap-1.5 justify-end">
            <span id="exif-camera" class="text-[#2A2A2A] font-medium">{firstPhoto.camera}</span>
            <span id="exif-film-dot" class="text-[#C5C5C5]" style={!firstPhoto.film ? 'display: none' : undefined}>·</span>
            <span id="exif-film" class="text-black font-semibold">{firstPhoto.film || ''}</span>
          </div>

          <!-- Row 2: Lens & Exposure Optics -->
          <div id="meta-exif" class="text-[0.64rem] sm:text-[0.68rem] text-[#888888] tracking-wider flex items-center gap-1.5 justify-end">
            <span id="exif-lens">{firstPhoto.lens || firstPhoto.exif?.focalLength || ''}</span>
            <span class="text-[#D8D8D8]">·</span>
            <span id="exif-optics">{photoOptics(firstPhoto)}</span>
          </div>
        </div>
      </footer>

    </main>

  </div>
  </>}
</Layout>

<style>
  #photo-mobile-heading, #photo-mobile-thumbnails { display: none; }
  @media (max-width: 767px), (hover: none) and (pointer: coarse) {
    :global(body.is-home) { overflow-x: clip; overflow-y: visible; overscroll-behavior: auto !important; }
    :global(body.is-home #site-wrapper) { max-height: none; }
    #gallery-viewport-root { height: auto; min-height: 0; flex: none; flex-direction: column; gap: 14px; margin-left: 0; padding: 8px 8px 28px; overflow: visible; }
    #gallery-viewport-root > aside { display: none; }
    #photo-mobile-heading { display: flex; align-items: center; gap: 12px; min-height: 44px; }
    #photo-year-select { background: transparent; color: #222; font-size: 14px; font-weight: 600; min-height: 44px; padding: 0 4px; }
    #photo-mobile-city { font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; }
    #right-showcase-stage { width: 100%; height: auto; flex: none; padding: 0; overflow: visible; gap: 18px; }
    #photo-canvas { flex: none; aspect-ratio: var(--photo-aspect); max-height: 65svh; padding: 0; touch-action: pan-y pinch-zoom; }
    .stage-layer-img { inset: 0; margin: auto; }
    #photo-mobile-thumbnails { display: flex; align-items: center; gap: 10px; overflow-x: auto; padding: 5px 2px; scroll-snap-type: x proximity; scrollbar-width: none; }
    #photo-mobile-thumbnails::-webkit-scrollbar { display: none; }
    #photo-mobile-thumbnails button { flex: 0 0 auto; height: 64px; min-width: 44px; padding: 3px; border-radius: 2px; opacity: 0.5; scroll-snap-align: center; transition: opacity 0.2s; }
    #photo-mobile-thumbnails button[aria-pressed="true"] { opacity: 1; box-shadow: 0 0 0 1px #555; }
    #photo-mobile-thumbnails img { width: auto; height: 100%; max-width: none; object-fit: contain; }
    #bottom-meta-footer { padding: 0 2px; height: auto; flex-direction: column; align-items: stretch; gap: 12px; overflow: visible; }
    #bottom-meta-footer > div:first-child > div { flex-direction: column; gap: 5px; white-space: normal; overflow: visible; }
    #meta-title { font-size: 17px; line-height: 1.4; overflow-wrap: anywhere; }
    #meta-location, #meta-story { white-space: normal; overflow: visible; overflow-wrap: anywhere; }
    #meta-story:empty { display: none; }
    #photo-camera-meta { min-width: 0; align-items: flex-start; text-align: left; }
    #photo-camera-meta > div { flex-wrap: wrap; justify-content: flex-start; }
    #photo-camera-meta span { overflow-wrap: anywhere; min-width: 0; }
  }
  @media (min-width: 768px) and (max-height: 500px) and (hover: hover) {
    #bottom-meta-footer { height: auto; flex-direction: column; align-items: stretch; gap: 10px; overflow: visible; }
    #bottom-meta-footer > div:first-child > div { flex-direction: column; gap: 3px; white-space: normal; overflow: visible; }
    #meta-title { font-size: 14px; line-height: 1.35; overflow-wrap: anywhere; }
    #meta-location, #meta-story { white-space: normal; overflow: visible; overflow-wrap: anywhere; }
    #photo-camera-meta { min-width: 0; align-items: flex-start; text-align: left; }
    #photo-camera-meta > div { flex-wrap: wrap; justify-content: flex-start; }
    #photo-camera-meta span { overflow-wrap: anywhere; min-width: 0; }
  }

  /* Defer depth mask to photo-wheel-viewport for pixel-accurate hairline docking */
  [data-rwp] {
    -webkit-mask-image: none !important;
    mask-image: none !important;
  }

  /* Dual Buffer Master Stage Layer Transition: Snappy 0.26s optical dissolve */
  .stage-layer-img {
    transition: opacity 0.26s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Prevent browser rubber-banding or window scroll */
  :global(html.is-home),
  :global(body.is-home),
  #gallery-viewport-root {
    overscroll-behavior: none !important;
  }
</style>

<script>
  import { allPhotos, photoOptics, photoLocation, type Photo } from '../../../data/photography';

  document.addEventListener('DOMContentLoaded', () => {
    // Dual buffer layers for flicker-free optical dissolve
    const layerA = document.getElementById('stage-layer-a') as HTMLImageElement;
    const layerB = document.getElementById('stage-layer-b') as HTMLImageElement;
    let activeLayer: 'A' | 'B' = 'A';
    let imageRequest = 0;
    let activeIndex = allPhotos.findIndex(photo => photo.imageUrl === layerA?.getAttribute('src'));
    const mobileLayout = matchMedia('(max-width: 767px), (hover: none) and (pointer: coarse)');
    const canvas = document.getElementById('photo-canvas');
    const thumbnails = document.getElementById('photo-mobile-thumbnails');
    const yearSelect = document.getElementById('photo-year-select') as HTMLSelectElement;
    const city = document.getElementById('photo-mobile-city');

    const metaTitle = document.getElementById('meta-title');
    const metaLocation = document.getElementById('meta-location');
    const metaStory = document.getElementById('meta-story');

    const cameraMeta = document.getElementById('photo-camera-meta');
    const exifCam = document.getElementById('exif-camera');
    const exifLens = document.getElementById('exif-lens');
    const exifFilm = document.getElementById('exif-film');
    const exifFilmDot = document.getElementById('exif-film-dot');
    const exifOptics = document.getElementById('exif-optics');

    const imageCache = new Set<string>();

    function preloadPhoto(url: string) {
      if (!url || imageCache.has(url)) return;
      const img = new Image();
      img.src = url;
      img.onload = () => imageCache.add(url);
    }

    // Warm the initial photos; full images load as the user explores.
    allPhotos.slice(1, 6).forEach(p => preloadPhoto(p.imageUrl));

    // Seamless Optical Morphing Image Switcher
    function morphToImage(imageUrl: string, title: string) {
      const request = ++imageRequest;
      if (!layerA || !layerB) return;

      let swapped = false;
      const performSwap = () => {
        if (swapped) return;
        swapped = true;
        requestAnimationFrame(() => {
          if (request !== imageRequest) return;
          const incomingLayer = activeLayer === 'A' ? layerB : layerA;
          const outgoingLayer = activeLayer === 'A' ? layerA : layerB;
          incomingLayer.src = imageUrl;
          incomingLayer.alt = title;
          incomingLayer.style.opacity = '1';
          outgoingLayer.style.opacity = '0';
          activeLayer = activeLayer === 'A' ? 'B' : 'A';
        });
      };

      const preloader = new Image();
      preloader.onload = performSwap;
      preloader.src = imageUrl;
      if (preloader.complete) {
        performSwap();
      }
    }

    function activatePhotoByIndex(index: number, options: { fromWheel?: boolean } = {}) {
      if (index < 0 || index >= allPhotos.length) return;
      const photo = allPhotos[index];
      if (!photo) return;
      activeIndex = index;
      canvas?.style.setProperty('--photo-aspect', `${photo.width} / ${photo.height}`);
      if (yearSelect) yearSelect.value = String(photo.year);
      if (city) city.textContent = photo.locationEn;
      thumbnails?.querySelectorAll('button').forEach(button => {
        const selected = Number(button.dataset.photoIndex) === index;
        button.setAttribute('aria-pressed', String(selected));
        if (selected && mobileLayout.matches) {
          thumbnails.scrollTo({ left: button.offsetLeft - thumbnails.offsetLeft - (thumbnails.clientWidth - button.offsetWidth) / 2, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        }
      });

      // 1. Morph master showcase image
      morphToImage(photo.imageUrl, photo.title);

      // 2. Immediate crisp typography update (Zero lag, Zero blink)
      if (metaTitle) metaTitle.textContent = photo.title;
      if (metaLocation) {
        metaLocation.textContent = photoLocation(photo);
      }
      if (metaStory) metaStory.textContent = photo.story ? `"${photo.story}"` : '';

      if (cameraMeta) cameraMeta.style.display = photo.camera || photo.exif ? '' : 'none';
      if (exifCam) exifCam.textContent = photo.camera || '';
      if (exifLens) exifLens.textContent = photo.lens || photo.exif?.focalLength || '';
      if (exifFilm) {
        exifFilm.textContent = photo.film || '';
        if (exifFilmDot) exifFilmDot.style.display = photo.film ? 'inline' : 'none';
      }
      if (exifOptics) {
        exifOptics.textContent = photoOptics(photo);
      }

      // 3. Warm the nearest photos without loading the whole archive.
      for (let offset = -3; offset <= 4; offset++) {
        const target = index + offset;
        if (offset !== 0 && target >= 0 && target < allPhotos.length) {
          preloadPhoto(allPhotos[target].imageUrl);
        }
      }

      // 4. If not triggered by wheel, notify 3D wheel to snap to the selected photo
      if (!options.fromWheel) {
        window.dispatchEvent(new CustomEvent('photography:external-photo-selected', { detail: photo }));
      }
    }

    // Listen for custom event from PhotographyWheelPicker (wheel selection)
    window.addEventListener('photography:photo-selected', ((e: CustomEvent<Photo>) => {
      if (e.detail) {
        const idx = allPhotos.findIndex(p => p.id === e.detail.id);
        if (idx !== -1) {
          activatePhotoByIndex(idx, { fromWheel: true });
        }
      }
    }) as EventListener);

    thumbnails?.addEventListener('click', event => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-photo-index]');
      if (button) activatePhotoByIndex(Number(button.dataset.photoIndex));
    });
    yearSelect?.addEventListener('change', () => {
      activatePhotoByIndex(allPhotos.findIndex(photo => photo.year === Number(yearSelect.value)));
    });
    // Let vertical gestures scroll the page; only a deliberate horizontal swipe changes photos.
    let swipe: { x: number; y: number; id: number } | null = null;
    canvas?.addEventListener('pointerdown', event => {
      if (!mobileLayout.matches || !event.isPrimary || event.button !== 0) return;
      swipe = { x: event.clientX, y: event.clientY, id: event.pointerId };
      canvas.setPointerCapture(event.pointerId);
    });
    canvas?.addEventListener('pointerup', event => {
      if (!swipe || swipe.id !== event.pointerId) return;
      const dx = event.clientX - swipe.x;
      const dy = event.clientY - swipe.y;
      swipe = null;
      if (Math.abs(dx) >= 35 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        activatePhotoByIndex(activeIndex + (dx < 0 ? 1 : -1));
      }
    });
    canvas?.addEventListener('pointercancel', () => { swipe = null; });

  });
</script>
