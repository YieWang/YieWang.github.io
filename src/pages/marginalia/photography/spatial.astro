---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { photographyChapters, allPhotos } from '../../../data/photography';

const firstPhoto = allPhotos[0];
---

<Layout
  title="Photography · Yi Wang"
  description="Photographic archive with cylindrical spatial roll."
  isHome={false}
  fullWidth={true}
>
  <Header activeTab="marginalia" />

  <!-- Fullscreen Spatial Canvas (Zero Breadcrumbs, Zero Selectors) -->
  <div class="w-full h-[calc(100vh-80px)] min-h-[580px] flex items-stretch gap-2 sm:gap-6 overflow-hidden select-none">
    
    <!-- LEFT: Cylindrical 3D Film Roller Track (Ultra-compact, ~120px, Docked to left edge) -->
    <aside class="w-[96px] sm:w-[115px] md:w-[130px] flex-shrink-0 h-full flex flex-col relative z-20 pl-1 sm:pl-2">
      <!-- 3D Cylindrical Viewport -->
      <div
        id="cylindrical-viewport"
        class="w-full h-full overflow-y-auto overflow-x-hidden space-y-5 py-12 pr-1 wheel-scroll-container"
        style="perspective: 1100px; perspective-origin: 50% 50%;"
      >
        {photographyChapters.map((chapter) => (
          <div class="space-y-4">
            <!-- Micro Year Stamp -->
            <div class="sticky top-0 z-30 bg-white/95 backdrop-blur-xs py-0.5 border-b border-[#EEEEEE] text-left">
              <span class="text-[0.75rem] font-bold text-[#333333] font-mono tracking-wider">
                {chapter.year}
              </span>
            </div>

            <!-- Only Thumbnails + Index Stamp -->
            <div class="space-y-3.5">
              {chapter.photos.map((photo) => (
                <div
                  id={`wheel-${photo.id}`}
                  class="wheel-card relative cursor-pointer rounded-[2px] transition-all duration-300 ease-out"
                  data-photo-json={JSON.stringify(photo)}
                  data-photo-id={photo.id}
                  style="transform-style: preserve-3d; will-change: transform, opacity;"
                >
                  <div class="relative w-full aspect-[3/2] bg-[#EAEAEA] rounded-[1px] overflow-hidden">
                    <img
                      src={photo.thumbnailUrl}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover pointer-events-none"
                    />
                    <!-- Micro Index Tag -->
                    <span class="absolute bottom-1 left-1 text-[0.52rem] font-mono font-medium text-white/95 bg-black/50 px-1 py-0.2 rounded-[1px]">
                      {String(allPhotos.findIndex(item => item.id === photo.id) + 1).padStart(2, '0')}
                    </span>
                    <div class="wheel-focus-ring absolute inset-0 ring-1 ring-black opacity-0 transition-opacity duration-200"></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
        <div class="h-20"></div>
      </div>
    </aside>

    <!-- RIGHT: Vast Full-Bleed Showcase Canvas -->
    <main class="flex-1 h-full flex flex-col items-center justify-center relative p-2 sm:p-4 overflow-hidden">
      <div class="relative w-full h-full flex items-center justify-center">
        <img
          id="wheel-stage-img"
          src={firstPhoto.imageUrl}
          alt={firstPhoto.title}
          class="max-w-full max-h-[86vh] w-auto h-auto object-contain transition-all duration-350 ease-out shadow-[0_12px_45px_rgba(0,0,0,0.08)] rounded-[2px]"
        />
      </div>

      <!-- Micro Exif Footnote -->
      <div class="absolute bottom-2 right-4 flex items-center gap-2.5 text-[0.68rem] font-mono text-[#777777] bg-white/80 backdrop-blur-sm px-2.5 py-1 rounded-[1px] select-none">
        <span id="wheel-stage-loc" class="font-medium text-[#222222] uppercase">
          {firstPhoto.locationEn} · {firstPhoto.year}
        </span>
        <span class="text-[#D0D0D0]">·</span>
        <span id="wheel-stage-cam">{firstPhoto.camera}</span>
      </div>
    </main>

  </div>
</Layout>

<style>
  .wheel-scroll-container::-webkit-scrollbar {
    width: 2px;
  }
  .wheel-scroll-container::-webkit-scrollbar-track {
    background: transparent;
  }
  .wheel-scroll-container::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.12);
    border-radius: 1px;
  }
  .wheel-card.wheel-focused {
    opacity: 1 !important;
    transform: translateZ(60px) scale(1.1) !important;
    box-shadow: 0 16px 36px -6px rgba(0, 0, 0, 0.35);
    z-index: 30;
  }
  .wheel-card.wheel-focused .wheel-focus-ring {
    opacity: 1 !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const viewport = document.getElementById('cylindrical-viewport');
    const cards = Array.from(document.querySelectorAll('.wheel-card')) as HTMLElement[];
    const stageImg = document.getElementById('wheel-stage-img') as HTMLImageElement;
    const stageLoc = document.getElementById('wheel-stage-loc');
    const stageCam = document.getElementById('wheel-stage-cam');

    let currentId = '';

    function showPhoto(photo: any) {
      if (!photo || photo.id === currentId) return;
      currentId = photo.id;

      if (stageImg) {
        stageImg.style.opacity = '0.35';
        stageImg.style.transform = 'scale(0.99)';

        const pre = new Image();
        pre.src = photo.imageUrl;
        pre.onload = () => {
          if (photo.id !== currentId) return;
          stageImg.src = photo.imageUrl;
          stageImg.style.opacity = '1';
          stageImg.style.transform = 'scale(1)';

          if (stageLoc) stageLoc.textContent = `${photo.locationEn} · ${photo.year}`;
          if (stageCam) stageCam.textContent = `${photo.camera} · ${photo.film || ''}`;
        };
      }
    }

    function calculateCylinder() {
      if (!viewport) return;
      const vRect = viewport.getBoundingClientRect();
      const centerY = vRect.top + vRect.height / 2;

      let bestCard: HTMLElement | null = null;
      let minDelta = Infinity;

      cards.forEach((card) => {
        const cRect = card.getBoundingClientRect();
        const cardCenter = cRect.top + cRect.height / 2;
        const delta = cardCenter - centerY;
        const absDelta = Math.abs(delta);

        if (absDelta < minDelta) {
          minDelta = absDelta;
          bestCard = card;
        }

        // Cylindrical arc projection formula:
        // Angle = delta / radius
        const radius = 260;
        const angle = Math.max(-32, Math.min(32, (delta / radius) * 28));
        const depth = Math.cos((angle * Math.PI) / 180) * 40 - 40; // Curves backwards
        const op = Math.max(0.28, 1 - absDelta / (vRect.height * 0.6));

        if (absDelta > 50) {
          card.classList.remove('wheel-focused');
          card.style.transform = `rotateX(${angle}deg) translateZ(${depth}px) scale(${Math.max(0.88, 1 - absDelta * 0.0006)})`;
          card.style.opacity = `${op}`;
        }
      });

      if (bestCard && minDelta <= 80) {
        const target = bestCard as HTMLElement;
        cards.forEach(c => {
          if (c !== target) c.classList.remove('wheel-focused');
        });
        target.classList.add('wheel-focused');
        target.style.transform = 'translateZ(64px) scale(1.1) rotateX(0deg)';
        target.style.opacity = '1';

        const pJson = target.getAttribute('data-photo-json');
        if (pJson) showPhoto(JSON.parse(pJson));
      }
    }

    if (cards.length > 0) {
      cards[0].classList.add('wheel-focused');
      const fJson = cards[0].getAttribute('data-photo-json');
      if (fJson) showPhoto(JSON.parse(fJson));
    }

    let ticking = false;
    viewport?.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          calculateCylinder();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const pJson = card.getAttribute('data-photo-json');
        if (pJson) showPhoto(JSON.parse(pJson));
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    calculateCylinder();
  });
</script>
