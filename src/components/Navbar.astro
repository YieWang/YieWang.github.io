---
import { profileData } from '../data/profile';
---

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-stone-200/80">
  <div class="max-w-4xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Name -->
    <a href="#about" class="text-base font-semibold text-stone-900 tracking-tight font-serif sm:text-lg hover:text-navy-900 transition-colors">
      {profileData.name} <span class="text-stone-500 font-sans text-xs font-normal ml-1">/ {profileData.chineseName}</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center space-x-7 text-sm text-stone-600 font-medium">
      <a href="#about" class="hover:text-navy-900 transition-colors">关于</a>
      <a href="#news" class="hover:text-navy-900 transition-colors">动态</a>
      <a href="#publications" class="hover:text-navy-900 transition-colors">学术成果</a>
      <a href="#interests" class="hover:text-navy-900 transition-colors">生活札记</a>
      <a href={profileData.socials.cvUrl || "#cv"} class="hover:text-navy-900 transition-colors">简历 (CV)</a>
    </nav>

    <!-- Contact Button -->
    <div class="flex items-center space-x-3">
      {profileData.socials.email && (
        <a
          href={profileData.socials.email}
          class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-stone-900 hover:bg-stone-800 text-white transition-all shadow-xs flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          联系邮箱
        </a>
      )}
    </div>
  </div>
</header>
