<div class="literature-book" aria-hidden="true">
  <iframe title="百年孤独翻书预览" data-src="/previews/literature" tabindex="-1"></iframe>
</div>

<style>
  .literature-book { width: 400px; height: 260px; }
  iframe { display: block; width: 100%; height: 100%; border: 0; pointer-events: none; }
</style>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('.literature-book iframe');
  const panel = frame?.closest<HTMLElement>('.stage-panel');
  const section = document.getElementById('marginalia-section');
  const stage = document.querySelector('.marginalia-stage');
  if (frame && panel && section && stage) {
    const syncBook = () => {
      const visible = panel.hasAttribute('data-active') && section.classList.contains('active-section')
        && !stage.hasAttribute('data-offscreen') && !document.hidden;
      // Release the preview document and GPU resources whenever its stage is hidden.
      if (visible && !frame.hasAttribute('src')) frame.src = frame.dataset.src!;
      else if (!visible && frame.hasAttribute('src')) frame.removeAttribute('src');
    };
    const observer = new MutationObserver(syncBook);
    observer.observe(panel, { attributes: true, attributeFilter: ['data-active'] });
    observer.observe(section, { attributes: true, attributeFilter: ['class'] });
    observer.observe(stage, { attributes: true, attributeFilter: ['data-offscreen'] });
    document.addEventListener('visibilitychange', syncBook);
    syncBook();
  }
</script>
