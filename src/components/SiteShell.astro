    transform: scale(0.98);
    pointer-events: none;
    transition: opacity 220ms ease, transform 400ms ease, visibility 0s 220ms;
  }
  .stage-panel[data-active] {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    pointer-events: auto;
    transition-delay: 0s;
  }
  .stage-panel > a {
    position: absolute;
    left: calc(50% - 237px);
    top: calc(50% - 135px);
    width: 400px;
