---
import Header from './Header.astro';
import { profileData } from '../data/profile';
import { notesData, expositionData, templateData } from '../data/mathematics';
import { marginaliaData } from '../data/marginalia';

interface Props {
  initialSection?: 'home' | 'mathematics' | 'marginalia';
}

const { initialSection = 'home' } = Astro.props;
---

<Header activeTab={initialSection} />

<!-- ================================================================= -->
<!-- SECTION 1: HOME (桌面单屏无滚动 + 移动端自适应画卷流)              -->
<!-- ================================================================= -->
<section
  id="home-section"
  class={`page-section w-full my-auto py-1 ${
    initialSection === 'home' ? 'active-section block' : 'inactive hidden'
  }`}
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-8 lg:gap-14 xl:gap-20 items-center h-full w-full min-w-0">
    
    <!-- Left Column: 姓名与学术简介 -->
    <div class="md:col-span-6 lg:col-span-6 min-w-0 space-y-4 sm:space-y-6 lg:space-y-8 md:pt-8 lg:pt-16 flex flex-col justify-center">
      
      <!-- Scholar Name (Yi Wang: Josefin Sans 700 Bold) -->
      <h1
        class="text-3xl sm:text-5xl lg:text-[3.25rem] xl:text-[3.75rem] font-bold uppercase tracking-[0.35rem] sm:tracking-[0.5rem] lg:tracking-[0.65rem] text-[#474747] leading-[1.15]"
        style="font-family: 'Josefin Sans', sans-serif;"
      >
        {profileData.name}
      </h1>

      <!-- Bio text (身份与核心方向) -->
      <div
        class="space-y-2 sm:space-y-3 text-[0.875rem] sm:text-[1rem] lg:text-[1.0625rem] text-[#474747] leading-[1.7] sm:leading-[1.85] tracking-[0.02rem] sm:tracking-[0.025rem] text-left"
        style="font-family: 'Montserrat', sans-serif; font-weight: 300;"
      >
        <p>
          I am {profileData.name} ({profileData.chineseName}), a Master's student in Mathematics at the {profileData.institution}.
        </p>
        <p>
          My research interests lie in Arithmetic Geometry, Algebraic Geometry, and Algebraic Number Theory.
        </p>
      </div>

      <!-- Single Email Icon (加大触摸热区) -->
      <div class="pt-1 sm:pt-2 flex items-center">
        <a
          href={profileData.socials.email}
          aria-label="Email"
          class="text-[#636363] hover:text-[#0F0F0F] transition-colors duration-200 inline-block p-1 -m-1"
          title="Email"
        >
          <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current" viewBox="0 0 40 40">
            <path d="M37.5,12.6l-17.5,11.9L2.5,12.6c-.2-.1-.3-.2-.5-.2v-2.7c0-.8.6-1.4,1.4-1.4h33.1c.8,0,1.4.6,1.4,1.4v2.7c-.2,0-.4,0-.5.2ZM19.5,26.3c.2.1.3.2.5.2s.4,0,.5-.2l17.5-11.9v16.9c0,.8-.6,1.4-1.4,1.4H3.4c-.8,0-1.4-.6-1.4-1.4V14.4l17.5,11.9Z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Right Column / 下方展区: 算术调和波 -->
    <div class="md:col-span-6 lg:col-span-6 min-w-0 flex justify-center md:justify-end w-full">
      <div
        id="wave-container-vertical"
        class="w-full max-w-full sm:max-w-[440px] lg:max-w-[480px] xl:max-w-[520px] md:h-[min(580px,68vh)] md:min-h-[350px] flex flex-col justify-between items-center relative select-none"
      >
        <!-- Top Anchor: REGENSBURG -->
        <div class="w-full text-center space-y-0.5 sm:space-y-1.5 relative z-10 flex-shrink-0">
          <div class="text-[0.625rem] sm:text-[0.75rem] font-mono text-[#737373] tracking-[0.14rem] sm:tracking-[0.16rem]">
            49°00′06″ N · 12°05′47″ E
          </div>
          <h3
            class="text-[0.75rem] sm:text-[0.875rem] font-medium tracking-[0.22rem] sm:tracking-[0.28rem] text-[#111111] uppercase"
            style="font-family: 'Montserrat', sans-serif;"
          >
            REGENSBURG
          </h3>
        </div>

        <!-- Middle Vertical Canvas -->
        <div class="relative flex-1 min-h-[100px] sm:min-h-[180px] md:min-h-[220px] w-full my-1 sm:my-2 flex items-center justify-center overflow-hidden">
          <canvas id="geodetic-canvas-vertical" class="w-full h-full block" style="touch-action: none;"></canvas>
        </div>

        <!-- Bottom Anchor: HANGZHOU -->
        <div class="w-full text-center space-y-0.5 sm:space-y-1.5 relative z-10 flex-shrink-0">
          <h3
            class="text-[0.75rem] sm:text-[0.875rem] font-medium tracking-[0.22rem] sm:tracking-[0.28rem] text-[#111111] uppercase"
            style="font-family: 'Montserrat', sans-serif;"
          >
            HANGZHOU
          </h3>
          <div class="text-[0.625rem] sm:text-[0.75rem] font-mono text-[#737373] tracking-[0.14rem] sm:tracking-[0.16rem]">
            30°18′55″ N · 120°21′52″ E
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ================================================================= -->
<!-- SECTION 2: MATHEMATICS (NOTES · EXPOSITION · TEMPLATE)            -->
<!-- ================================================================= -->
<section
  id="mathematics-section"
  class={`page-section max-w-2xl mx-auto w-full space-y-8 sm:space-y-12 pt-9 sm:pt-[clamp(4rem,7.5vh,5.5rem)] pb-8 sm:pb-12 ${
    initialSection === 'mathematics' ? 'active-section block' : 'inactive hidden'
  }`}
>
  <!-- 1. NOTES -->
  <div class="space-y-4 sm:space-y-5.5 pt-1 sm:pt-2">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        NOTES
      </h3>
    </div>
    <div class="space-y-3.5 sm:space-y-4.5 text-left">
      {notesData.map((item) => (
        <article>
          <h4 class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5]">
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-[#333333] hover:text-black underline underline-offset-4 decoration-[#D1D1D1] hover:decoration-black transition-colors duration-200"
              style="font-family: 'Montserrat', sans-serif;"
            >
              {item.title}
            </a>
          </h4>
        </article>
      ))}
    </div>
  </div>

  <!-- 2. EXPOSITION -->
  <div class="space-y-4 sm:space-y-5.5 pt-2.5 sm:pt-3.5">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        EXPOSITION
      </h3>
    </div>
    <div class="space-y-3.5 sm:space-y-4.5 text-left">
      {expositionData.map((item) => (
        <article class="space-y-1">
          <h4
            class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5] font-bold text-[#333333]"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {item.title}
          </h4>
          <p
            class="text-[0.75rem] sm:text-[0.8125rem] text-[#888888] font-light tracking-[0.02rem]"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {item.type} · {item.year}
          </p>
        </article>
      ))}
    </div>
  </div>

  <!-- 3. TEMPLATE -->
  <div class="space-y-4 sm:space-y-5.5 pt-2.5 sm:pt-3.5">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        TEMPLATE
      </h3>
    </div>
    <div class="space-y-3.5 sm:space-y-4.5 text-left">
      {templateData.map((item) => (
        <article class="space-y-1">
          <h4
            class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5] font-bold text-[#333333]"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {item.title}
          </h4>
          <p
            class="text-[0.75rem] sm:text-[0.8125rem] text-[#888888] font-light tracking-[0.02rem] flex items-center gap-2 flex-wrap"
            style="font-family: 'Montserrat', sans-serif;"
          >
            <span>{item.type}</span>
            <span class="text-[#D1D1D1]">·</span>
            <a
              href={item.previewUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#555555] hover:text-black underline underline-offset-4 decoration-[#CCCCCC] hover:decoration-black transition-colors duration-200 py-1"
            >
              Preview
            </a>
            <span class="text-[#D1D1D1]">·</span>
            <a
              href={item.sourceUrl}
              download
              class="text-[#555555] hover:text-black underline underline-offset-4 decoration-[#CCCCCC] hover:decoration-black transition-colors duration-200 py-1"
            >
              Source
            </a>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ================================================================= -->
<!-- SECTION 3: MARGINALIA (PROJECT & INTERESTS)                       -->
<!-- ================================================================= -->
<section
  id="marginalia-section"
  class={`page-section max-w-2xl mx-auto w-full space-y-8 sm:space-y-12 pt-9 sm:pt-[clamp(4rem,7.5vh,5.5rem)] pb-8 sm:pb-12 ${
    initialSection === 'marginalia' ? 'active-section block' : 'inactive hidden'
  }`}
>
  <!-- 1. PROJECT -->
  <div class="space-y-4 sm:space-y-5.5 pt-1 sm:pt-2">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        PROJECT
      </h3>
    </div>
    <div class="space-y-3.5 sm:space-y-4.5 text-left">
      <article>
        <h4 class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5]">
          <a
            href={marginaliaData.project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-[#333333] hover:text-black underline underline-offset-4 decoration-[#D1D1D1] hover:decoration-black transition-colors duration-200"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {marginaliaData.project.title}
          </a>
        </h4>
      </article>
    </div>
  </div>

  <!-- 2. INTERESTS (Scheme B Split Stage + Scheme C Tactile Dynamics) -->
  <div class="space-y-4 sm:space-y-5.5 pt-2.5 sm:pt-3.5">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        INTERESTS
      </h3>
    </div>

    <!-- Split Stage Grid: Left Titles + Right Showcase Stage -->
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 sm:gap-8 items-start">
      <!-- Left Column: Categories List -->
      <div class="sm:col-span-4 space-y-4 sm:space-y-5.5 text-left">
        {marginaliaData.interests.map((item, idx) => (
          <article>
            <h4 class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5]">
              {item.hasLink ? (
                <a
                  href={item.href}
                  class={`stage-trigger font-bold transition-colors duration-200 block ${
                    idx === 0
                      ? 'active-stage-trigger text-black'
                      : 'text-[#666666] hover:text-black'
                  }`}
                  data-stage-id={item.id}
                  style="font-family: 'Montserrat', sans-serif;"
                >
                  {item.title}
                </a>
              ) : (
                <span
                  class="font-bold text-[#888888] cursor-default select-none block"
                  style="font-family: 'Montserrat', sans-serif;"
                >
                  {item.title}
                </span>
              )}
            </h4>
          </article>
        ))}
      </div>

      <!-- Right Column: Interactive Stage (Distinct Physical Mediums, Elevated Level with Top Title) -->
      <div class="sm:col-span-8 relative min-h-[260px] sm:min-h-[290px] flex items-start justify-center -translate-y-4 sm:-translate-y-6">
        
        <!-- 1. Photography Panel: Archival Prints Inspection (Dual Layers Float & Tilt) -->
        <div
          id="stage-panel-photography"
          class="stage-panel absolute inset-0 flex items-start justify-center transition-all duration-300 opacity-100 scale-100 z-10 pointer-events-auto"
        >
          <a
            href="/marginalia/photography"
            class="relative w-full h-full flex items-start justify-center pt-0 sm:pt-0 cursor-pointer select-none"
            title="Photography"
          >
            <div class="photo-container relative w-[280px] sm:w-[330px] h-[210px] sm:h-[240px] flex items-center justify-center">
              <!-- Background Secondary Print (Slides out angled) -->
              <div class="photo-secondary absolute w-[160px] sm:w-[185px] h-[200px] sm:h-[230px] rounded-[2px] bg-white border border-[#D5D5D5] p-2 shadow-[0_4px_16px_rgba(0,0,0,0.06)] flex flex-col justify-between">
                <div
                  class="w-full h-full rounded-[1px] p-2 flex flex-col justify-between"
                  style="background: linear-gradient(135deg, #ECE6DE 0%, #D8D0C5 100%);"
                >
                  <div class="flex justify-between items-center text-[0.5rem] sm:text-[0.56rem] font-mono text-[#666666]">
                    <span>01 · CATHEDRAL</span>
                    <span>KODAK 400</span>
                  </div>
                  <div class="text-right text-[0.44rem] sm:text-[0.5rem] font-mono text-[#777777]">35mm MONO</div>
                </div>
                <div class="pt-1 text-[0.44rem] sm:text-[0.5rem] font-mono text-[#999999] text-center tracking-wider">
                  REGIONAL ARCHIVE
                </div>
              </div>

              <!-- Foreground Primary Print (Elevates & Floats with soft shadow) -->
              <div class="photo-primary relative z-10 w-[230px] sm:w-[270px] h-[155px] sm:h-[180px] rounded-[2px] bg-white border border-[#CCCCCC] p-2.5 sm:p-3 shadow-[0_8px_24px_rgba(0,0,0,0.08)] flex flex-col justify-between">
                <div
                  class="w-full flex-1 rounded-[1px] p-2.5 flex flex-col justify-between text-left"
                  style="background: linear-gradient(135deg, #242424 0%, #121212 100%);"
                >
                  <div class="flex items-center justify-between">
                    <span
                      class="text-[0.6rem] sm:text-[0.68rem] font-bold text-white tracking-wide"
                      style="font-family: 'Montserrat', sans-serif;"
                    >
                      Danube · Stone Bridge
                    </span>
                    <span class="text-[0.48rem] sm:text-[0.54rem] font-mono text-white/60">LEICA M6</span>
                  </div>
                  <div class="flex items-end justify-between">
                    <span class="text-[0.46rem] sm:text-[0.52rem] font-mono text-white/50">SUMMICRON 35/2</span>
                    <span class="text-[0.46rem] sm:text-[0.52rem] font-mono text-white/70"># 04 / 25</span>
                  </div>
                </div>
                <div class="pt-1.5 flex justify-between items-center text-[0.44rem] sm:text-[0.5rem] font-mono text-[#888888]">
                  <span class="italic font-serif">Regensburg, 2024</span>
                  <span>SILVER GELATIN</span>
                </div>
              </div>
            </div>
          </a>
        </div>

        <!-- 2. Cinema Panel: Three.js Flow / CurveModifier 35mm S-Curved Film Strip (真实3D弯曲胶卷) -->
        <div
          id="stage-panel-cinema"
          class="stage-panel absolute inset-0 flex items-start justify-center transition-all duration-300 opacity-0 scale-[0.98] z-0 pointer-events-none"
        >
          <a
            href="/marginalia/cinema"
            class="relative w-full h-full flex items-start justify-center pt-2 sm:pt-2.5 cursor-pointer select-none overflow-visible"
            title="Cinema"
          >
            <div class="cinema-three-container relative w-[340px] sm:w-[400px] h-[210px] sm:h-[240px] flex items-center justify-center">
              <!-- Warm Projector Spotlight Halo behind the curved celluloid -->
              <div class="cinema-projector-halo absolute w-48 sm:w-56 h-48 sm:h-56 rounded-full bg-amber-500/20 blur-3xl transition-all duration-700 pointer-events-none"></div>
              
              <!-- Three.js Canvas where Flow / CurveModifier bends the 35mm film strip along 3D CatmullRom spline -->
              <canvas id="cinema-canvas" class="relative z-10 w-full h-full block cursor-pointer select-none pointer-events-auto"></canvas>
            </div>
          </a>
        </div>

        <!-- 3. Literature Panel: Codrops 3D Hardcover Tome with 24mm Paper Brick & Double-Sided Flip Cover -->
        <div
          id="stage-panel-literature"
          class="stage-panel absolute inset-0 flex items-start justify-center transition-all duration-300 opacity-0 scale-[0.98] z-0 pointer-events-none"
        >
          <a
            href="/marginalia/literature"
            class="relative w-full h-full flex items-start justify-center pt-2 sm:pt-3 cursor-pointer select-none"
            title="Literature"
          >
            <div class="book-codrops-stage relative w-[250px] sm:w-[280px] h-[210px] sm:h-[240px] flex items-center justify-center">
              
              <!-- 3-Tier Desk Contact Ground Shadows (紧贴桌面的超柔和多层接触阴影) -->
              <div class="book-desk-shadow-trough absolute bottom-1 w-[190px] sm:w-[220px] h-2 bg-black/25 rounded-full blur-[2px] pointer-events-none transition-all duration-700"></div>
              <div class="book-desk-shadow-ambient absolute bottom-0 w-[220px] sm:w-[250px] h-4 bg-black/10 rounded-full blur-[6px] pointer-events-none transition-all duration-700"></div>
              <div class="book-desk-shadow-diffuse absolute -bottom-1 w-[250px] sm:w-[280px] h-6 bg-black/[0.06] rounded-full blur-[12px] pointer-events-none transition-all duration-700"></div>

              <!-- 3D Book Assembly (Perspectived with realistic tilt) -->
              <div class="book-assembly relative w-[160px] sm:w-[172px] h-[195px] sm:h-[215px]">
                
                <!-- 1. Right Hardcover Backing Base Plate (Z=-2px) -->
                <div class="book-hardcover-backing absolute -inset-1 rounded-r-[4px] bg-[#16120E] border border-[#3A2E22] shadow-[0_6px_18px_rgba(0,0,0,0.16)]" style="transform: translateZ(-2px);"></div>

                <!-- 2. Center Spine Binding (深棕烫金书脊) -->
                <div class="book-spine absolute left-0 top-0 bottom-0 w-[24px] origin-left [transform:rotateY(-90deg)] bg-gradient-to-r from-[#110D09] via-[#241D15] to-[#1A140F] border-l border-[#3D3123] flex items-center justify-center z-10">
                  <span class="text-[0.38rem] font-mono font-bold text-[#D4AF37] tracking-widest uppercase rotate-90 whitespace-nowrap">GEB · HOFSTADTER</span>
                </div>

                <!-- 3. Central Gutter Crease Trough (书脊凹陷装订咬合槽) -->
                <div class="book-gutter-trough absolute -left-1.5 top-0 bottom-0 w-3 pointer-events-none z-30" style="transform: translateZ(25px); background: linear-gradient(to right, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.12) 48%, rgba(0,0,0,0.12) 52%, rgba(0,0,0,0.5) 100%);">
                  <div class="absolute left-1/2 top-1 bottom-1 w-[1px] -translate-x-1/2 bg-[#2D2218]/70"></div>
                </div>

                <!-- 4. Red Silk Ribbon Bookmark (Cascading from spine head trough) -->
                <div class="book-ribbon-silk absolute -top-3 -left-1 w-2 sm:w-2.5 h-36 bg-gradient-to-b from-[#7F1D1D] via-[#DC2626] to-[#991B1B] shadow-[1.5px_3px_8px_rgba(0,0,0,0.3)] pointer-events-none z-40" style="transform: translateZ(28px); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 6px), 50% 100%, 0 calc(100% - 6px));"></div>

                <!-- 5. Solid 3D Pages Block (24mm Paper Brick - 真实侧边厚纸砖) -->
                <div class="book-pages-block absolute inset-0" style="transform-style: preserve-3d;">
                  <!-- Right Edge (书口厚纸砖切面 - 24px thick paper pages) -->
                  <div class="book-brick-right absolute right-0 top-[1px] bottom-[1px] w-[24px] origin-right [transform:rotateY(90deg)] border-r border-[#C4B7A4] shadow-inner" style="background: repeating-linear-gradient(0deg, #E6DDD0 0px, #D8CEBE 1px, #F5F0E6 2px, #E2D8C8 3px);"></div>
                  
                  <!-- Top Edge (天头厚纸砖切面) -->
                  <div class="book-brick-top absolute left-[1px] right-[1px] top-0 h-[24px] origin-top [transform:rotateX(-90deg)] border-t border-[#C4B7A4]" style="background: repeating-linear-gradient(90deg, #E6DDD0 0px, #D8CEBE 1px, #F5F0E6 2px, #E2D8C8 3px);"></div>

                  <!-- Bottom Edge (地脚厚纸砖切面) -->
                  <div class="book-brick-bottom absolute left-[1px] right-[1px] bottom-0 h-[24px] origin-bottom [transform:rotateX(90deg)] border-b border-[#C4B7A4]" style="background: repeating-linear-gradient(90deg, #E6DDD0 0px, #D8CEBE 1px, #F5F0E6 2px, #E2D8C8 3px);"></div>

                  <!-- Stacked Loose Pages (纸张堆叠体积: 两层错位底页在书口微微露出) -->
                  <div class="absolute inset-0 rounded-r-[2px] border border-[#D5CBB9]" style="transform: translateZ(20px) rotateY(-1.2deg) translateX(3px); transform-origin: left center; background: linear-gradient(to right, #BFB49F 0%, #E9E1D1 26%, #EFE8D9 100%);"></div>
                  <div class="absolute inset-0 rounded-r-[2px] border border-[#DED4C2]" style="transform: translateZ(22px) rotateY(-2.4deg) translateX(1.5px); transform-origin: left center; background: linear-gradient(to right, #C8BDA9 0%, #EFE9DB 26%, #F4EFE3 100%);"></div>

                  <!-- Right Inside Page (Page 108 Hofstadter Quote, 从书脊自然拱起: 脊侧凹陷阴影 → 拱顶受光带) -->
                  <div class="book-page-first absolute inset-0 rounded-r-[2px] border border-[#DDD4C4] p-3.5 sm:p-4 flex flex-col justify-between shadow-[inset_12px_0_18px_rgba(0,0,0,0.12)] overflow-hidden" style="transform: translateZ(24px) rotateY(-5.5deg); transform-origin: left center; background: linear-gradient(to right, #A89C87 0%, #C9BEA9 4%, #EFE8D9 10%, #FFFDF4 22%, #FAF8F0 72%, #E6DCCB 100%);">
                    <!-- Cylindrical Page Arch Highlight & Gutter Arch Shadow -->
