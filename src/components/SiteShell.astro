<!-- ================================================================= -->
<!-- SCRIPTS: 客户端路由内核 + 纵向调和测地波渲染引擎                    -->
<!-- ================================================================= -->
<script>
  import type * as THREE_NS from 'three';

  const pageTitles: Record<string, string> = {
    home: 'Yi Wang',
    mathematics: 'Mathematics · Yi Wang',
    marginalia: 'Marginalia · Yi Wang'
  };

  function updateScrollState(targetId: string) {
    document.documentElement.classList.add('is-home');
    document.body.classList.add('is-home');
    document.body.classList.toggle('home-active', targetId === 'home');
  }

  let transitionTimer: ReturnType<typeof setTimeout> | null = null;

  function activateSection(targetId: string, instant = false) {
    if (transitionTimer) {
      clearTimeout(transitionTimer);
      transitionTimer = null;
    }

    const targetSec = document.getElementById(targetId + '-section');
    if (!targetSec) return;

    // 延迟加载 Three.js 胶卷：仅在首次进入 marginalia 区时才下载并初始化
    if (targetId === 'marginalia') initCinemaThree();

    const currentSec = document.querySelector('.page-section.active-section') as HTMLElement | null;

    if (pageTitles[targetId]) {
      document.title = pageTitles[targetId];
    }

    // 立即更新导航链接的高亮状态
    document.querySelectorAll('.nav-link').forEach((link) => {
      link.classList.remove('text-black', 'font-bold', 'active-nav');
      link.classList.add('text-[#737373]', 'font-medium');
    });

    const activeLink = document.getElementById('nav-' + targetId);
    if (activeLink) {
      activeLink.classList.add('text-black', 'font-bold', 'active-nav');
      activeLink.classList.remove('text-[#737373]', 'font-medium');
    }

    // 初始加载或同一 section 无需过渡
    if (instant || !currentSec || currentSec === targetSec) {
      document.querySelectorAll('.page-section').forEach((sec) => {
        if (sec === targetSec) {
          sec.classList.remove('hidden', 'inactive');
          sec.classList.add('block', 'active-section');
        } else {
          sec.classList.add('hidden', 'inactive');
          sec.classList.remove('block', 'active-section');
        }
      });
      updateScrollState(targetId);
      window.scrollTo({ top: 0, behavior: 'instant' });
      if (targetId === 'home') {
        window.dispatchEvent(new Event('resize'));
      }
      if (targetId === 'marginalia') {
        const panels = document.querySelectorAll('.stage-panel');
        panels.forEach((p) => p.classList.remove('is-expanded'));
        setTimeout(() => {
          const target = document.querySelector('.stage-panel.opacity-100') || document.getElementById('stage-panel-photography');
          if (target) target.classList.add('is-expanded');
        }, 200);
      }
      return;
    }

    // 三个主栏目保持相同的桌面单屏滚动规则
    if (targetId !== 'home') {
      updateScrollState(targetId);
    }

    // 1. 缩放淡出当前页面 (Julian Perilla 1:1 特征: scale(1 -> 0.96), opacity(1 -> 0))
    currentSec.classList.add('inactive');

    transitionTimer = setTimeout(() => {
      // 2. 隐藏当前页面
      document.querySelectorAll('.page-section').forEach((sec) => {
        if (sec !== targetSec) {
          sec.classList.add('hidden', 'inactive');
          sec.classList.remove('block', 'active-section');
        }
      });

      // 3. 进入首页时，在旧长页面已隐藏后立即锁屏并重置滚动位置，杜绝滚动条闪烁
      if (targetId === 'home') {
        window.scrollTo({ top: 0, behavior: 'instant' });
        updateScrollState('home');
      } else {
        window.scrollTo({ top: 0, behavior: 'instant' });
      }

      // 4. 将目标页面置入 DOM 并准备淡入 (初始为 scale(0.96), opacity: 0)
      targetSec.classList.remove('hidden');
      targetSec.classList.add('block', 'inactive');

      // 5. 强制同步回流重排以确保 CSS transition 生效
      void targetSec.offsetWidth;

      // 6. 优雅缩放淡入 (Julian Perilla 1:1 特征: scale(0.96 -> 1), opacity(0 -> 1))
      targetSec.classList.remove('inactive');
      targetSec.classList.add('active-section');

      if (targetId === 'home') {
        window.dispatchEvent(new Event('resize'));
      }
      if (targetId === 'marginalia') {
        const panels = document.querySelectorAll('.stage-panel');
        panels.forEach((p) => p.classList.remove('is-expanded'));
        setTimeout(() => {
          const target = document.querySelector('.stage-panel.opacity-100') || document.getElementById('stage-panel-photography');
          if (target) target.classList.add('is-expanded');
        }, 150);
      }
      transitionTimer = null;
    }, 180);
  }

  // 监听导航点击事件：拦截内部链接，保持 1:1 丝滑交错动画并推入干净路由 (无 #)
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as HTMLElement).closest('a');
    if (!link) return;

    const href = link.getAttribute('href');
    if (!href) return;

    // 外部链接、CV 下载或邮箱不拦截
    if (link.target === '_blank' || href.startsWith('http') || href.endsWith('.pdf') || href.startsWith('mailto:')) {
      return;
    }

    let targetId = link.getAttribute('data-target');
    if (!targetId) {
      if (href === '/' || href === '/#home' || href === '#home') targetId = 'home';
      else if (href === '/mathematics' || href === '/#mathematics' || href === '#mathematics') targetId = 'mathematics';
      else if (href === '/marginalia' || href === '/#marginalia' || href === '#marginalia') targetId = 'marginalia';
    }

    if (targetId) {
      e.preventDefault();
      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      const targetPath = targetId === 'home' ? '/' : `/${targetId}`;

      if (currentPath !== targetPath || window.location.hash) {
        history.pushState({ section: targetId }, '', targetPath);
      }
      activateSection(targetId, false);
    }
  });

  // 监听浏览器前进/后退 (popstate)
  window.addEventListener('popstate', () => {
    const pathname = window.location.pathname.replace(/\/$/, '') || '/';
    let targetId = 'home';
    if (pathname === '/mathematics') targetId = 'mathematics';
    else if (pathname === '/marginalia') targetId = 'marginalia';
    activateSection(targetId, false);
  });

  // 处理旧 URL 遗留的 # 锚点，并平滑升级至干净的斜杠 URL
  if (window.location.hash) {
    const hash = window.location.hash.substring(1).toLowerCase();
    if (hash === 'mathematics' || hash === 'research') {
      history.replaceState({ section: 'mathematics' }, '', '/mathematics');
      activateSection('mathematics', true);
    } else if (hash === 'marginalia' || hash === 'notes') {
      history.replaceState({ section: 'marginalia' }, '', '/marginalia');
      activateSection('marginalia', true);
    } else {
      history.replaceState({ section: 'home' }, '', '/');
      activateSection('home', true);
    }
  } else {
    const curPath = window.location.pathname.replace(/\/$/, '') || '/';
    if (curPath === '/marginalia') {
      initCinemaThree();
      setTimeout(() => {
        const p = document.getElementById('stage-panel-photography');
        if (p) p.classList.add('is-expanded');
      }, 280);
    }
  }

  // =========================================================================
  // MARGINALIA INTERACTIVE STAGE CONTROLLER (Scheme B + C)
  // =========================================================================
  function setStage(stageId: string) {
    const panels = document.querySelectorAll('.stage-panel');
    panels.forEach((p) => {
      if (p.id !== `stage-panel-${stageId}`) {
        p.classList.remove('opacity-100', 'scale-100', 'z-10', 'pointer-events-auto', 'is-expanded');
        p.classList.add('opacity-0', 'scale-[0.98]', 'z-0', 'pointer-events-none');
      }
    });

    const targetPanel = document.getElementById(`stage-panel-${stageId}`);
    if (targetPanel) {
      targetPanel.classList.remove('opacity-0', 'scale-[0.98]', 'z-0', 'pointer-events-none');
      targetPanel.classList.add('opacity-100', 'scale-100', 'z-10', 'pointer-events-auto');
      // Smoothly trigger expansion upon hover and KEEP it expanded without merging back
      setTimeout(() => {
        targetPanel.classList.add('is-expanded');
      }, 20);
    }

    const triggers = document.querySelectorAll('.stage-trigger');
    triggers.forEach((t) => {
      const isTarget = t.getAttribute('data-stage-id') === stageId;
      if (isTarget) {
        t.classList.add('active-stage-trigger', 'text-black');
        t.classList.remove('text-[#666666]');
      } else {
        t.classList.remove('active-stage-trigger', 'text-black');
        t.classList.add('text-[#666666]');
      }
    });
  }

  document.addEventListener('mouseover', (e) => {
    const trigger = (e.target as HTMLElement).closest('.stage-trigger');
    if (!trigger) return;
    const stageId = trigger.getAttribute('data-stage-id');
    if (!stageId) return;
    setStage(stageId);
  });

  document.addEventListener('focusin', (e) => {
    const trigger = (e.target as HTMLElement).closest('.stage-trigger');
    if (!trigger) return;
    const stageId = trigger.getAttribute('data-stage-id');
    if (!stageId) return;
    setStage(stageId);
  });

  // =========================================================================
  // GEODETIC HARMONIC WAVE ENGINE (纵向算术调和测地波)
  // =========================================================================
  function initGeodeticEngine() {
    const vCanvas = document.getElementById('geodetic-canvas-vertical') as HTMLCanvasElement | null;
    if (!vCanvas) return;

    const vCtx = vCanvas.getContext('2d');
    if (!vCtx) return;

    let vWidth = 0, vHeight = 0;
    let animId: number | null = null;
    const startTime = performance.now();

    function resize() {
      if (!vCanvas || !vCtx) return;
      const dpr = window.devicePixelRatio || 1;
      const rect = vCanvas.getBoundingClientRect();
      vWidth = rect.width;
      vHeight = rect.height;
      vCanvas.width = Math.round(vWidth * dpr);
      vCanvas.height = Math.round(vHeight * dpr);
      vCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    const ro = new ResizeObserver(() => resize());
    if (vCanvas.parentElement) ro.observe(vCanvas.parentElement);
    window.addEventListener('resize', resize);
    resize();

    const fibers = [
      { f1: 1, f2: 2, sp1: 1.1, sp2: 0.7, ph: 0, color: 'rgba(26, 26, 26, 0.88)', width: 1.6 },
      { f1: 1.5, f2: 3, sp1: -0.8, sp2: 0.9, ph: 1.4, color: 'rgba(0, 0, 0, 0.28)', width: 1.0 },
      { f1: 0.8, f2: 1.5, sp1: 0.5, sp2: -0.5, ph: 2.8, color: 'rgba(0, 0, 0, 0.10)', width: 0.75 }
    ];

    function render(now: number) {
      const homeSec = document.getElementById('home-section');
      if (!homeSec || homeSec.classList.contains('hidden')) {
        animId = requestAnimationFrame(render);
        return;
      }

      const t = (now - startTime) / 1000;
      if (vCtx && vWidth > 0 && vHeight > 0) {
        vCtx.clearRect(0, 0, vWidth, vHeight);

        const padTop = 6;
        const padBottom = vHeight - 6;
        const lineH = Math.max(10, padBottom - padTop);
        const midX = Math.round(vWidth / 2);
        const ampMax = Math.min(68, vWidth * 0.28);

        fibers.forEach((fib) => {
          vCtx.beginPath();
          vCtx.strokeStyle = fib.color;
          vCtx.lineWidth = fib.width;
          const steps = 90;
          for (let i = 0; i <= steps; i++) {
            const u = i / steps;
            const y = padTop + u * lineH;
            const envelope = Math.sin(u * Math.PI);
            const w1 = Math.sin(u * Math.PI * 2 * fib.f1 + t * fib.sp1 + fib.ph);
            const w2 = Math.sin(u * Math.PI * 2 * fib.f2 - t * fib.sp2 + fib.ph) * 0.35;
            const x = midX + envelope * ampMax * (w1 + w2);
            if (i === 0) vCtx.moveTo(x, y);
            else vCtx.lineTo(x, y);
          }
          vCtx.stroke();
        });

        // 顶点与底点锚点
        [padTop, padBottom].forEach((y) => {
          vCtx.beginPath();
          vCtx.strokeStyle = 'rgba(0, 0, 0, 0.35)';
          vCtx.lineWidth = 1;
          vCtx.arc(midX, y, 4, 0, Math.PI * 2);
          vCtx.stroke();

          vCtx.beginPath();
          vCtx.fillStyle = '#111111';
          vCtx.arc(midX, y, 1.8, 0, Math.PI * 2);
          vCtx.fill();
        });
      }

      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);
  }

  // =========================================================================
  // =========================================================================
  // CINEMA THREE.JS 35MM CURVED CELLULOID FILM RIBBON (参数化3D弯曲胶卷)
  // =========================================================================
  async function initCinemaThree() {
    const canvas = document.getElementById('cinema-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    if ((canvas as any).__cinemaInitialized) return;
    (canvas as any).__cinemaInitialized = true;

    const {
      Scene,
      PerspectiveCamera,
      WebGLRenderer,
      AmbientLight,
      DirectionalLight,
      PointLight,
      CanvasTexture,
      RepeatWrapping,
      ClampToEdgeWrapping,
      CatmullRomCurve3,
      Vector3,
      BufferGeometry,
      Float32BufferAttribute,
      MeshStandardMaterial,
      Mesh,
      DoubleSide
    } = await import('three');

    const w = canvas.clientWidth || 380;
    const h = canvas.clientHeight || 230;

    const scene = new Scene();
    const camera = new PerspectiveCamera(55, w / h, 0.1, 100);
    camera.position.set(0, 0.4, 10.9);

    let renderer: THREE_NS.WebGLRenderer;
    try {
      renderer = new WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true
      });
      renderer.setSize(w, h);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    } catch (e) {
      console.warn('WebGL context creation failed:', e);
      return;
    }

    const ambientLight = new AmbientLight(0xffffff, 1.3);
    scene.add(ambientLight);

    const dirLight = new DirectionalLight(0xfffaed, 2.2);
    dirLight.position.set(6, 9, 14);
    scene.add(dirLight);

    const projectorLight = new PointLight(0xffe8c2, 4.8, 32);
    projectorLight.position.set(0.5, 3.5, 8.5);
    scene.add(projectorLight);

    const rimLight = new DirectionalLight(0x7dd3fc, 1.8);
    rimLight.position.set(-8, 6, -4);
    scene.add(rimLight);

    // High-Resolution 35mm Celluloid Film Strip Texture (2048 x 300)
    const texCanvas = document.createElement('canvas');
    texCanvas.width = 2048;
    texCanvas.height = 300;
    const ctx = texCanvas.getContext('2d');
    if (ctx) {
      // Base dark celluloid border
      ctx.fillStyle = 'rgba(16, 14, 12, 0.96)';
      ctx.fillRect(0, 0, texCanvas.width, texCanvas.height);

      // Darker sprocket margins
      ctx.fillStyle = 'rgba(8, 7, 6, 0.99)';
      ctx.fillRect(0, 0, texCanvas.width, 42);
      ctx.fillRect(0, texCanvas.height - 42, texCanvas.width, 42);

      // Cut out authentic see-through sprocket holes!
      const numSprockets = 56;
      const spW = 16, spH = 24;
      const step = texCanvas.width / numSprockets;

      for (let i = 0; i < numSprockets; i++) {
        const x = i * step + 8;
        ctx.clearRect(x, 9, spW, spH);
        ctx.clearRect(x, texCanvas.height - 33, spW, spH);
      }

      // Latent Keykode Barcode along upper track
      ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
      for (let i = 0; i < numSprockets; i += 4) {
        const bx = i * step + 30;
        for (let b = 0; b < 6; b++) {
          ctx.fillRect(bx + b * 2.2, 14, 1.2, 14);
        }
      }

      // Edge typography
      ctx.fillStyle = 'rgba(245, 158, 11, 0.92)';
      ctx.font = 'bold 11px monospace';
      ctx.fillText('EASTMAN 5219  ▶ 23A  SAFETY FILM', 60, 26);
      ctx.fillText('KODAK VISION3  ▶ 24A  35MM 24FPS', 580, 26);
      ctx.fillText('CINÉ-ARCHIVE   ▶ 25A  SCENE 108', 1100, 26);
      ctx.fillText('TECHNICOLOR    ▶ 26A  NITRATE BASE', 1600, 26);

      ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';
      ctx.font = '10px monospace';
      ctx.fillText('24 FPS · 2.39:1 ANAMORPHIC', 70, texCanvas.height - 14);
      ctx.fillText('LATENT IMAGE KEYCODE · 1979', 590, texCanvas.height - 14);
      ctx.fillText('DIRECTOR CUT MASTER · 1993', 1110, texCanvas.height - 14);
      ctx.fillText('ACADEMY APERTURE · 1953', 1610, texCanvas.height - 14);

      // Film Frames
      const fW = 440, fH = 196, fY = 52;

      // Frame 1: Tokyo Story (Silver Gelatin Tatami Axis)
      const f1X = 60;
      ctx.fillStyle = '#1C1917';
      ctx.fillRect(f1X, fY, fW, fH);
      ctx.strokeStyle = 'rgba(255,255,255,0.25)';
      ctx.lineWidth = 2;
      ctx.strokeRect(f1X, fY, fW, fH);
      const g1 = ctx.createLinearGradient(f1X, fY, f1X + fW, fY + fH);
      g1.addColorStop(0, '#2D2824');
      g1.addColorStop(1, '#181412');
      ctx.fillStyle = g1;
      ctx.fillRect(f1X + 16, fY + 16, fW - 32, fH - 32);
      ctx.fillStyle = '#FAF5EB';
      ctx.font = 'bold 26px sans-serif';
      ctx.fillText('Tokyo Story', f1X + 32, fY + 74);
      ctx.fillStyle = 'rgba(250, 245, 235, 0.7)';
      ctx.font = '13px monospace';
      ctx.fillText('YASUJIRO OZU · 1953', f1X + 32, fY + 104);
      ctx.fillText('TATAMI AXIS · 35MM GELATIN', f1X + 32, fY + 132);

      // Frame 2: Stalker (Luminous Golden Amber Sepia)
      const f2X = 560;
      ctx.fillStyle = '#261C0E';
      ctx.fillRect(f2X, fY, fW, fH);
      ctx.strokeStyle = 'rgba(245, 158, 11, 0.95)';
      ctx.lineWidth = 3;
      ctx.strokeRect(f2X, fY, fW, fH);
      const g2 = ctx.createLinearGradient(f2X, fY, f2X + fW, fY + fH);
      g2.addColorStop(0, '#4D3618');
      g2.addColorStop(0.5, '#684A22');
      g2.addColorStop(1, '#38250E');
      ctx.fillStyle = g2;
      ctx.fillRect(f2X + 16, fY + 16, fW - 32, fH - 32);
      ctx.fillStyle = '#FFF8EB';
      ctx.font = 'bold 30px sans-serif';
      ctx.fillText('Stalker', f2X + 32, fY + 74);
      ctx.fillStyle = 'rgba(245, 158, 11, 0.95)';
      ctx.font = 'bold 14px monospace';
      ctx.fillText('ANDREI TARKOVSKY · 1979', f2X + 32, fY + 106);
      ctx.fillStyle = 'rgba(255, 248, 235, 0.85)';
      ctx.font = '13px sans-serif';
      ctx.fillText('The Zone · Room of Desires', f2X + 32, fY + 134);

      // Frame 3: Trois Couleurs: Bleu (Deep Luminous Cobalt)
      const f3X = 1060;
      ctx.fillStyle = '#0F172A';
      ctx.fillRect(f3X, fY, fW, fH);
      ctx.strokeStyle = 'rgba(96, 165, 250, 0.85)';
      ctx.lineWidth = 2.5;
      ctx.strokeRect(f3X, fY, fW, fH);
      const g3 = ctx.createLinearGradient(f3X, fY, f3X + fW, fY + fH);
      g3.addColorStop(0, '#1E3A8A');
      g3.addColorStop(0.5, '#172554');
      g3.addColorStop(1, '#0F172A');
      ctx.fillStyle = g3;
      ctx.fillRect(f3X + 16, fY + 16, fW - 32, fH - 32);
      ctx.fillStyle = '#EFF6FF';
      ctx.font = 'bold 26px sans-serif';
      ctx.fillText('Trois Couleurs: Bleu', f3X + 32, fY + 74);
      ctx.fillStyle = 'rgba(147, 197, 253, 0.9)';
      ctx.font = '13px monospace';
      ctx.fillText('KRZYSZTOF KIEŚLOWSKI · 1993', f3X + 32, fY + 104);
      ctx.fillText('LIBERTÉ · COBALT CHANDELIER', f3X + 32, fY + 132);

      // Frame 4: In the Mood for Love (Rich Velvet Emerald Noir)
      const f4X = 1560;
      ctx.fillStyle = '#06281E';
      ctx.fillRect(f4X, fY, fW, fH);
      ctx.strokeStyle = 'rgba(52, 211, 153, 0.8)';
      ctx.lineWidth = 2;
      ctx.strokeRect(f4X, fY, fW, fH);
      const g4 = ctx.createLinearGradient(f4X, fY, f4X + fW, fY + fH);
      g4.addColorStop(0, '#064E3B');
      g4.addColorStop(0.5, '#042F2E');
      g4.addColorStop(1, '#021B16');
      ctx.fillStyle = g4;
      ctx.fillRect(f4X + 16, fY + 16, fW - 32, fH - 32);
      ctx.fillStyle = '#ECFDF5';
      ctx.font = 'bold 26px sans-serif';
      ctx.fillText('In the Mood for Love', f4X + 32, fY + 74);
      ctx.fillStyle = 'rgba(110, 231, 183, 0.85)';
      ctx.font = '13px monospace';
      ctx.fillText('WONG KAR-WAI · 2000', f4X + 32, fY + 104);
      ctx.fillText('YUMEJI THEME · 2046 QIPAO', f4X + 32, fY + 132);
    }

    const texture = new CanvasTexture(texCanvas);
    texture.wrapS = RepeatWrapping;
    texture.wrapT = ClampToEdgeWrapping;
    texture.repeat.set(1.0, 1.0);

    // Dynamic 3D Curving Spline: 深 Z 轴纵深（近大远小 + 前后穿越遮挡）
    const curve = new CatmullRomCurve3([
      new Vector3(-8.2, 2.2, -9.5),
      new Vector3(-4.4, -2.2, -3.6),
      new Vector3(0.0, 0.9, 3.4),
      new Vector3(4.6, -2.4, -2.2),
      new Vector3(8.2, 1.9, -9.0)
    ]);
    curve.curveType = 'centripetal';

    // Extruded 3D Solid Ribbon with Physical Edge Thickness (0.09)
    function createSolidRibbon(spline: THREE_NS.CatmullRomCurve3, segments = 240, width = 3.8, thickness = 0.09) {
      const points = spline.getPoints(segments);
      const positions: number[] = [];
      const normals: number[] = [];
      const uvs: number[] = [];
      const indices: number[] = [];

      let prevTangent = spline.getTangent(0).normalize();
      let prevNormal = new Vector3(0, 1, 0);
      let binormal = new Vector3().crossVectors(prevTangent, prevNormal).normalize();
      prevNormal.crossVectors(binormal, prevTangent).normalize();

      for (let i = 0; i <= segments; i++) {
        const u = i / segments;
        const p = points[i];
        const tangent = spline.getTangent(u).normalize();

        const rotAxis = new Vector3().crossVectors(prevTangent, tangent);
        if (rotAxis.lengthSq() > 1e-6) {
          const angle = Math.asin(Math.min(1, rotAxis.length()));
          rotAxis.normalize();
          prevNormal.applyAxisAngle(rotAxis, angle);
        }
        prevTangent.copy(tangent);

        // 温和的自然侧倾：胶片只随弧线轻微侧倾，保持"胶片"而非"扭曲丝带"的观感
        const bankAngle = Math.sin(u * Math.PI * 1.6) * 0.3 + (u - 0.5) * 0.26;
        const n = new Vector3().copy(prevNormal).applyAxisAngle(tangent, bankAngle).normalize();
        const b = new Vector3().crossVectors(tangent, n).normalize();

        const halfW = width / 2;
        const halfT = thickness / 2;

        const ft = new Vector3().copy(p).addScaledVector(n, halfW).addScaledVector(b, halfT);
        const fb = new Vector3().copy(p).addScaledVector(n, -halfW).addScaledVector(b, halfT);
        const bt = new Vector3().copy(p).addScaledVector(n, halfW).addScaledVector(b, -halfT);
        const bb = new Vector3().copy(p).addScaledVector(n, -halfW).addScaledVector(b, -halfT);

        positions.push(ft.x, ft.y, ft.z);
        positions.push(fb.x, fb.y, fb.z);
        positions.push(bt.x, bt.y, bt.z);
        positions.push(bb.x, bb.y, bb.z);

        normals.push(b.x, b.y, b.z);
        normals.push(b.x, b.y, b.z);
        normals.push(-b.x, -b.y, -b.z);
        normals.push(-b.x, -b.y, -b.z);

        uvs.push(u * 1.3, 1.0);
        uvs.push(u * 1.3, 0.0);
        uvs.push(u * 1.3, 1.0);
        uvs.push(u * 1.3, 0.0);

        if (i < segments) {
          const idx = i * 4;
          // Front face
          indices.push(idx + 0, idx + 1, idx + 4);
          indices.push(idx + 4, idx + 1, idx + 5);

          // Back face
          indices.push(idx + 6, idx + 3, idx + 2);
          indices.push(idx + 7, idx + 3, idx + 6);

          // Top edge
          indices.push(idx + 2, idx + 0, idx + 6);
          indices.push(idx + 6, idx + 0, idx + 4);

          // Bottom edge
          indices.push(idx + 1, idx + 3, idx + 5);
          indices.push(idx + 5, idx + 3, idx + 7);
        }
      }

      const geom = new BufferGeometry();
      geom.setAttribute('position', new Float32BufferAttribute(positions, 3));
      geom.setAttribute('normal', new Float32BufferAttribute(normals, 3));
      geom.setAttribute('uv', new Float32BufferAttribute(uvs, 2));
      geom.setIndex(indices);
      return geom;
    }

    // 加厚的实体胶片：0.3 单位侧边厚度，近景段清晰可见胶片边缘
    const geometry = createSolidRibbon(curve, 260, 3.6, 0.3);
    const material = new MeshStandardMaterial({
      map: texture,
      alphaTest: 0.4,
      roughness: 0.3,
      metalness: 0.14,
      emissive: 0x161008,
      emissiveIntensity: 0.45,
      side: DoubleSide
    });

    const mesh = new Mesh(geometry, material);
    scene.add(mesh);

    function resizeCanvas() {
      if (!canvas) return;
      const newW = canvas.clientWidth || 380;
      const newH = canvas.clientHeight || 230;
      if (newW > 0 && newH > 0) {
        camera.aspect = newW / newH;
        camera.updateProjectionMatrix();
        renderer.setSize(newW, newH);
      }
    }

    const startTime = performance.now();

    function renderCinema() {
      requestAnimationFrame(renderCinema);

      const panel = document.getElementById('stage-panel-cinema');
      if (!panel) return;
      const isVisible = panel.classList.contains('opacity-100') || panel.classList.contains('is-expanded');
      const isExpanded = panel.classList.contains('is-expanded');

      if (!isVisible) return;

      if (canvas && canvas.clientWidth > 0 && renderer.domElement.width === 0) {
        resizeCanvas();
      }

      const elapsed = (performance.now() - startTime) * 0.001;

      // Continuous film gliding through the projector gate
      texture.offset.x += 0.0012;

      // Organic 3D ribbon floating and drifting in space
      mesh.rotation.y = Math.sin(elapsed * 0.7) * 0.06;
      mesh.rotation.x = Math.cos(elapsed * 0.5) * 0.04;
      mesh.rotation.z = Math.sin(elapsed * 0.4) * 0.02;
      mesh.position.y = Math.sin(elapsed * 0.9) * 0.16;

      const targetScale = isExpanded ? 1.06 : 1.0;
      mesh.scale.lerp(new Vector3(targetScale, targetScale, targetScale), 0.08);

      projectorLight.intensity = isExpanded ? 5.6 : 4.2;

      renderer.render(scene, camera);
    }

    renderCinema();

    window.addEventListener('resize', resizeCanvas);
  }

  // 初始化波形动画（Three.js 胶卷已延迟至进入 marginalia 区时加载）
  initGeodeticEngine();
</script>
