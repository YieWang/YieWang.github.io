  .stage-touch-hint { display: none; font-size: 10px; color: #777; text-align: center; }
  @container (max-width: 399px) { .stage-panel > a { transform: scale(0.94); } }
  @container (max-width: 379px) { .stage-panel > a { transform: scale(0.86); } }
  @container (max-width: 339px) { .stage-panel > a { transform: scale(0.78); } }
  @container (max-width: 299px) { .stage-panel > a { transform: scale(0.69); } }
