  .is-expanded .photo-secondary { animation: photo-secondary-enter 850ms cubic-bezier(0.22, 0.7, 0.25, 1) 240ms both; transform: translate(-62px, 12px) rotate(-11deg); box-shadow: 0 10px 20px #00000016; }
  .is-expanded .photo-primary { animation: photo-primary-enter 850ms cubic-bezier(0.22, 0.7, 0.25, 1) 240ms both; transform: translate(28px, -8px) rotate(4deg); box-shadow: 0 14px 25px #00000020; }

  @keyframes photo-secondary-enter {
