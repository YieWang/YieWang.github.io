  }
  .gameboy-white {
    --gameboy-depth: 36px;
    transform-style: preserve-3d;
    transform: rotateY(-25deg) rotateX(10deg) rotateZ(-2deg);

    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .is-expanded .gameboy-white {
    transform: rotateY(-30deg) rotateX(12deg) rotateZ(-2deg) translateY(-4px);

  }
  .gameboy-back { position: absolute; inset: 0; border-radius: 14px 14px 26px 14px; background: #c0c7c766; border: 1px solid #a3aeae99; box-shadow: 5px 9px 16px #00000020; }
  .gameboy-side-right, .gameboy-side-left { position: absolute; top: 13px; bottom: 24px; width: var(--gameboy-depth); transform-origin: left; transform: rotateY(-90deg); background: linear-gradient(to right, #7f8a8abd, #d5dede77 45%, #77848499 49%, #f8ffffcc 53%, #c7d2d266); border: 1px solid #ffffffbb; }
  .gameboy-side-right { left: 100%; }
  .gameboy-side-left { left: 0; border-color: #91a0a0bb; background: linear-gradient(to right, #94a0a099, #edf1f1aa 42%, #9ba8a8aa 49%, #ffffffcc 55%, #c4cece88); }
  .gameboy-side-top, .gameboy-side-bottom { position: absolute; left: 13px; right: 13px; height: var(--gameboy-depth); transform-origin: top; transform: rotateX(90deg); background: linear-gradient(to bottom, #94a0a077, #dfe6e677 48%, #7e898977 51%, #f5f9f999 55%); }
  .gameboy-side-top { top: 0; }
  .gameboy-side-bottom { top: 100%; right: 24px; }
  .gameboy-side-corner { position: absolute; left: 100%; top: calc(100% - 24px); width: 33.94px; height: var(--gameboy-depth); transform-origin: top left; transform: rotateZ(135deg) rotateX(90deg); background: linear-gradient(to bottom, #8e9a9a88, #dfe6e677 48%, #7b898977 51%, #dde5e588 55%); }
  .gameboy-volume { position: absolute; top: 45px; left: 10px; width: 12px; height: 31px; border-radius: 3px; background: repeating-linear-gradient(#333b3d 0 2px, #717b7d 2px 3px); box-shadow: 0 0 0 2px #a6afb0; }
  .gameboy-circuit { position: absolute; inset: 0; width: 100%; height: 100%; transform: translateZ(27px); }
  .gameboy-white .gameboy-front {
    background: linear-gradient(120deg, #ffffffa3, #d9e0e047 42%, #f2f6f66b 70%, #aab8b847);
    border-color: #ffffffcc;
    box-shadow: inset 2px 0 1px #87939399, inset 4px 0 2px #ffffffdd, inset 0 2px 2px #ffffffdd, inset -2px -1px 3px #76858577;
  }
  .gameboy-front::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(120deg, transparent 15%, #ffffff26 16%, #ffffff09 33%, transparent 34%, transparent 75%, #ffffff20 76%, transparent 91%); }
  .gameboy-white .gameboy-bezel { background-color: #41494c; border-color: #30393c; }
  .gameboy-ground-shadow {
    transform: translateX(12px) translateY(8px);
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .is-expanded .gameboy-ground-shadow {
    transform: translateX(14px) translateY(12px) scale(1.1);
    opacity: 0.18;
  }
  .gameboy-led {
    transition: background-color 0.4s ease, box-shadow 0.4s ease;
  }
  .is-expanded .gameboy-led {
    background-color: #EF4444;
    box-shadow: 0 0 5px #ef444455;
  }
  .gameboy-lcd {
    background: linear-gradient(145deg, #ffffff, #eeeeee);
    transition: filter 0.4s ease;
  }
  .is-expanded .gameboy-lcd {
    filter: brightness(1.08) contrast(1.05);
  }
  .gameboy-controls { position: relative; height: 76px; }
  .gameboy-system-buttons { position: absolute; bottom: 0; left: 30px; }
  .gameboy-ground-shadow { opacity: 0.15; }
  .gameboy-well { width: 58%; height: 100%; color: #333333; overflow: hidden; }
  .gameboy-falling-block { transform: translateY(60px); }
  .gameboy-score { position: relative; }
  .gameboy-score span:last-child { position: absolute; left: 0; top: 0; opacity: 0; }
  .is-expanded .gameboy-falling-block { animation: tetris-drop 4.8s linear infinite; }
  .is-expanded .gameboy-clear-row { animation: tetris-clear 4.8s linear infinite; }
  .is-expanded .gameboy-upper-stack { animation: tetris-settle 4.8s linear infinite; }
  .is-expanded .gameboy-score span:first-child { animation: tetris-old-score 4.8s step-end infinite; }
  .is-expanded .gameboy-score span:last-child { animation: tetris-new-score 4.8s step-end infinite; }
  @keyframes tetris-drop {
    0%, 8% { transform: translateY(0); opacity: 1; animation-timing-function: steps(6, end); }
    58%, 68% { transform: translateY(60px); opacity: 1; }
    71%, 75% { transform: translateY(60px); opacity: 0.15; }
    73%, 77% { transform: translateY(60px); opacity: 1; }
    79%, 100% { transform: translateY(60px); opacity: 0; }
  }
  @keyframes tetris-clear { 0%, 68%, 73%, 77% { opacity: 1; } 71%, 75% { opacity: 0.15; } 79%, 100% { opacity: 0; } }
  @keyframes tetris-settle { 0%, 79% { transform: translateY(0); opacity: 1; } 86%, 94% { transform: translateY(20px); opacity: 1; } 100% { transform: translateY(20px); opacity: 0; } }
  @keyframes tetris-old-score { 0%, 100% { opacity: 1; } 79% { opacity: 0; } }
  @keyframes tetris-new-score { 0%, 100% { opacity: 0; } 79% { opacity: 1; } }

  #marginalia-section.inactive .stage-panel *,
  .marginalia-stage[data-offscreen] *,
  .marginalia-stage[data-paused] * { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) {
    .page-section, .stage-panel, .stage-panel * { animation: none !important; transition: none !important; }
    .is-expanded .tt-ball-rig { transform: translateZ(55px); }
    .is-expanded .gameboy-falling-block { transform: translateY(60px); }
  }
</style>

<!-- ================================================================= -->
<!-- SCRIPTS: 客户端路由内核 + 纵向调和测地波渲染引擎                    -->
<!-- ================================================================= -->
<script>

  const pageTitles: Record<string, string> = {
    home: 'Yi Wang',
    mathematics: 'Mathematics · Yi Wang',
    marginalia: 'Marginalia · Yi Wang'
  };

  function updateScrollState(targetId: string) {
    document.documentElement.classList.add('is-home');
    document.body.classList.add('is-home');
    document.body.classList.toggle('home-active', targetId === 'home');
  }

  let transitionTimer: ReturnType<typeof setTimeout> | null = null;

  function activateSection(targetId: string, instant = false) {
    if (transitionTimer) {
      clearTimeout(transitionTimer);
      transitionTimer = null;
    }

    const targetSec = document.getElementById(targetId + '-section');
    if (!targetSec) return;

    const currentSec = document.querySelector('.page-section.active-section') as HTMLElement | null;

    if (pageTitles[targetId]) {
      document.title = pageTitles[targetId];
    }

    // 立即更新导航链接的高亮状态
    document.querySelectorAll('.nav-link').forEach((link) => {
      link.classList.remove('text-black', 'font-bold', 'active-nav');
      link.classList.add('text-[#737373]', 'font-medium');
    });

    const activeLink = document.getElementById('nav-' + targetId);
    if (activeLink) {
      activeLink.classList.add('text-black', 'font-bold', 'active-nav');
      activeLink.classList.remove('text-[#737373]', 'font-medium');
    }

    // 初始加载或同一 section 无需过渡
    if (instant || !currentSec || currentSec === targetSec) {
      document.querySelectorAll('.page-section').forEach((sec) => {
        if (sec === targetSec) {
          sec.classList.remove('hidden', 'inactive');
          sec.classList.add('block', 'active-section');
        } else {
          sec.classList.add('hidden', 'inactive');
          sec.classList.remove('block', 'active-section');
        }
      });
      updateScrollState(targetId);
      window.scrollTo({ top: 0, behavior: 'instant' });
      if (targetId === 'home') {
        window.dispatchEvent(new Event('resize'));
      }
      if (targetId === 'marginalia') enterMarginalia();

      return;
    }

    // 三个主栏目保持相同的桌面单屏滚动规则
    if (targetId !== 'home') {
      updateScrollState(targetId);
    }

    // 1. 缩放淡出当前页面 (Julian Perilla 1:1 特征: scale(1 -> 0.96), opacity(1 -> 0))
    currentSec.classList.add('inactive');

    transitionTimer = setTimeout(() => {
      // 2. 隐藏当前页面
      document.querySelectorAll('.page-section').forEach((sec) => {
        if (sec !== targetSec) {
          sec.classList.add('hidden', 'inactive');
          sec.classList.remove('block', 'active-section');
        }
      });

      // 3. 进入首页时，在旧长页面已隐藏后立即锁屏并重置滚动位置，杜绝滚动条闪烁
      if (targetId === 'home') {
        window.scrollTo({ top: 0, behavior: 'instant' });
        updateScrollState('home');
      } else {
        window.scrollTo({ top: 0, behavior: 'instant' });
      }

      // 4. 将目标页面置入 DOM 并准备淡入 (初始为 scale(0.96), opacity: 0)
      targetSec.classList.remove('hidden');
      targetSec.classList.add('block', 'inactive');

      // 5. 强制同步回流重排以确保 CSS transition 生效
      void targetSec.offsetWidth;

      // 6. 优雅缩放淡入 (Julian Perilla 1:1 特征: scale(0.96 -> 1), opacity(0 -> 1))
      targetSec.classList.remove('inactive');
      targetSec.classList.add('active-section');

      if (targetId === 'home') {
        window.dispatchEvent(new Event('resize'));
      }
      if (targetId === 'marginalia') enterMarginalia();

      transitionTimer = null;
    }, 180);
  }

  // 监听导航点击事件：拦截内部链接，保持 1:1 丝滑交错动画并推入干净路由 (无 #)
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as HTMLElement).closest('a');
    if (!link) return;

    const href = link.getAttribute('href');
    if (!href) return;

    // 外部链接、CV 下载或邮箱不拦截
    if (link.target === '_blank' || href.startsWith('http') || href.endsWith('.pdf') || href.startsWith('mailto:')) {
      return;
    }

    let targetId = link.getAttribute('data-target');
    if (!targetId) {
      if (href === '/' || href === '/#home' || href === '#home') targetId = 'home';
      else if (href === '/mathematics' || href === '/#mathematics' || href === '#mathematics') targetId = 'mathematics';
      else if (href === '/marginalia' || href === '/#marginalia' || href === '#marginalia') targetId = 'marginalia';
    }

    if (targetId) {
      e.preventDefault();
      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      const targetPath = targetId === 'home' ? '/' : `/${targetId}`;

      if (currentPath !== targetPath || window.location.hash) {
        history.pushState({ section: targetId }, '', targetPath);
      }
      activateSection(targetId, false);
    }
  });

  // 监听浏览器前进/后退 (popstate)
  window.addEventListener('popstate', () => {
    const pathname = window.location.pathname.replace(/\/$/, '') || '/';
    let targetId = 'home';
    if (pathname === '/mathematics') targetId = 'mathematics';
    else if (pathname === '/marginalia') targetId = 'marginalia';
    activateSection(targetId, false);
  });

  // 处理旧 URL 遗留的 # 锚点，并平滑升级至干净的斜杠 URL
  if (window.location.hash) {
    const hash = window.location.hash.substring(1).toLowerCase();
    if (hash === 'mathematics' || hash === 'research') {
      history.replaceState({ section: 'mathematics' }, '', '/mathematics');
      activateSection('mathematics', true);
    } else if (hash === 'marginalia' || hash === 'notes') {
      history.replaceState({ section: 'marginalia' }, '', '/marginalia');
      activateSection('marginalia', true);
    } else {
      history.replaceState({ section: 'home' }, '', '/');
      activateSection('home', true);
    }
  }

  // =========================================================================
  // MARGINALIA INTERACTIVE STAGE CONTROLLER (Scheme B + C)
  // =========================================================================
  function setStage(stageId: string) {
    const target = document.getElementById(`stage-panel-${stageId}`);
    if (!target || target.dataset.active === 'true') return;
    document.querySelectorAll<HTMLElement>('.stage-panel').forEach(panel => {
      const active = panel === target;
      panel.inert = !active;
      panel.setAttribute('aria-hidden', String(!active));
      panel.toggleAttribute('data-active', active);
      if (active) panel.dataset.active = 'true';
      panel.classList.toggle('is-expanded', active);
    });
    document.querySelectorAll('.stage-trigger').forEach(trigger => {
      const active = trigger.getAttribute('data-stage-id') === stageId;
      trigger.classList.toggle('active-stage-trigger', active);
      trigger.classList.toggle('text-black', active);
      trigger.classList.toggle('text-[#666666]', !active);
      if (active) trigger.setAttribute('aria-current', 'true');
      else trigger.removeAttribute('aria-current');
    });
  }

  function enterMarginalia() {
    setStage('photography');
    const photo = document.getElementById('stage-panel-photography');
    if (!photo) return;
    photo.classList.remove('is-expanded');
    // Flush animation removal so every navigation restarts the explicit stacked keyframe.
    void photo.offsetWidth;
    photo.classList.add('is-expanded');
  }

  for (const eventName of ['pointerover', 'focusin']) {
    document.addEventListener(eventName, event => {
      if (event instanceof PointerEvent && event.pointerType !== 'mouse') return;
      const trigger = (event.target as Element).closest<HTMLElement>('.stage-trigger');
      if (trigger?.dataset.stageId) setStage(trigger.dataset.stageId);
    });
  }
  document.addEventListener('click', event => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const trigger = (event.target as Element).closest<HTMLElement>('.stage-trigger');
    if (trigger?.dataset.stageId && window.matchMedia('(hover: none)').matches) {
      event.preventDefault();
      setStage(trigger.dataset.stageId);
    }
  });
  const stage = document.querySelector<HTMLElement>('.marginalia-stage');
  if (stage) {
    new IntersectionObserver(([entry]) => {
      stage.toggleAttribute('data-offscreen', !entry.isIntersecting);
    }).observe(stage);
    document.addEventListener('visibilitychange', () => {
      stage.toggleAttribute('data-paused', document.hidden);
    });
  }

  if (document.getElementById('marginalia-section')?.classList.contains('active-section')) enterMarginalia();

  // =========================================================================
  // GEODETIC HARMONIC WAVE ENGINE (纵向算术调和测地波)
  // =========================================================================
  function initGeodeticEngine() {
    const vCanvas = document.getElementById('geodetic-canvas-vertical') as HTMLCanvasElement | null;
    if (!vCanvas) return;

    const vCtx = vCanvas.getContext('2d');
    if (!vCtx) return;

    let vWidth = 0, vHeight = 0;
    const startTime = performance.now();

    function resize() {
      if (!vCanvas || !vCtx) return;
      const dpr = window.devicePixelRatio || 1;
      const rect = vCanvas.getBoundingClientRect();
      vWidth = rect.width;
      vHeight = rect.height;
      vCanvas.width = Math.round(vWidth * dpr);
      vCanvas.height = Math.round(vHeight * dpr);
      vCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    const ro = new ResizeObserver(() => resize());
    if (vCanvas.parentElement) ro.observe(vCanvas.parentElement);
    window.addEventListener('resize', resize);
    resize();

    const fibers = [
      { f1: 1, f2: 2, sp1: 1.1, sp2: 0.7, ph: 0, color: 'rgba(26, 26, 26, 0.88)', width: 1.6 },
      { f1: 1.5, f2: 3, sp1: -0.8, sp2: 0.9, ph: 1.4, color: 'rgba(0, 0, 0, 0.28)', width: 1.0 },
      { f1: 0.8, f2: 1.5, sp1: 0.5, sp2: -0.5, ph: 2.8, color: 'rgba(0, 0, 0, 0.10)', width: 0.75 }
    ];

    function render(now: number) {
      const homeSec = document.getElementById('home-section');
      if (!homeSec || homeSec.classList.contains('hidden')) {
        requestAnimationFrame(render);
        return;
      }

      const t = (now - startTime) / 1000;
      if (vCtx && vWidth > 0 && vHeight > 0) {
        vCtx.clearRect(0, 0, vWidth, vHeight);

        const padTop = 6;
        const padBottom = vHeight - 6;
        const lineH = Math.max(10, padBottom - padTop);
        const midX = Math.round(vWidth / 2);
        const ampMax = Math.min(68, vWidth * 0.28);

        fibers.forEach((fib) => {
          vCtx.beginPath();
          vCtx.strokeStyle = fib.color;
          vCtx.lineWidth = fib.width;
          const steps = 90;
          for (let i = 0; i <= steps; i++) {
            const u = i / steps;
            const y = padTop + u * lineH;
            const envelope = Math.sin(u * Math.PI);
            const w1 = Math.sin(u * Math.PI * 2 * fib.f1 + t * fib.sp1 + fib.ph);
            const w2 = Math.sin(u * Math.PI * 2 * fib.f2 - t * fib.sp2 + fib.ph) * 0.35;
            const x = midX + envelope * ampMax * (w1 + w2);
            if (i === 0) vCtx.moveTo(x, y);
            else vCtx.lineTo(x, y);
          }
          vCtx.stroke();
        });

        // 顶点与底点锚点
        [padTop, padBottom].forEach((y) => {
          vCtx.beginPath();
          vCtx.strokeStyle = 'rgba(0, 0, 0, 0.35)';
          vCtx.lineWidth = 1;
          vCtx.arc(midX, y, 4, 0, Math.PI * 2);
          vCtx.stroke();

          vCtx.beginPath();
          vCtx.fillStyle = '#111111';
          vCtx.arc(midX, y, 1.8, 0, Math.PI * 2);
          vCtx.fill();
        });
      }

      requestAnimationFrame(render);
    }

    requestAnimationFrame(render);
  }

  initGeodeticEngine();
</script>
