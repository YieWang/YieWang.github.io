---
import Header from './Header.astro';
import LiteratureBook from './LiteratureBook.astro';
import { allPhotos } from '../data/photography';
import { allCinemaItems } from '../data/cinema';
import { musicAlbums } from '../data/music';

import { profileData } from '../data/profile';
import { notesData, expositionData, templateData } from '../data/mathematics';
import { marginaliaData } from '../data/marginalia';

interface Props {
  initialSection?: 'home' | 'mathematics' | 'marginalia';
}

const { initialSection = 'home' } = Astro.props;

const archivePrint = allPhotos.find(photo => photo.id === '202408-tokyo-10')!;
const lakePrint = allPhotos.find(photo => photo.id === '202303-hangzhou-west-lake-01')!;
const musicCover = musicAlbums.find(album => album.id === 'apple-album-3e54067bb25e92d0')!;
const cinemaFrames = ['film-1298624', 'film-1291832', 'film-1296141', 'film-1296339']
  .map(id => allCinemaItems.find(item => item.id === id)!);


const racketOutline = 'M80 6 C123 6 152 39 152 82 C152 116 134 141 99 150 L94 156 C91 177 93 203 97 223 Q99 229 90 229 L70 229 Q61 229 63 223 C67 203 69 177 66 156 L61 150 C26 141 8 116 8 82 C8 39 37 6 80 6 Z';
const rubberOutline = 'M80 10 C120 10 148 41 148 82 C148 115 130 139 96 147 Q80 153 64 147 C30 139 12 115 12 82 C12 41 40 10 80 10 Z';
const handleOutline = 'M66 149 Q80 154 94 149 C90 177 93 203 97 223 Q99 229 90 229 L70 229 Q61 229 63 223 C67 203 70 177 66 149 Z';


---

<Header activeTab={initialSection} />

<!-- ================================================================= -->
<!-- SECTION 1: HOME (桌面单屏无滚动 + 移动端自适应画卷流)              -->
<!-- ================================================================= -->
<section
  id="home-section"
  class={`page-section w-full my-auto py-1 ${
    initialSection === 'home' ? 'active-section block' : 'inactive hidden'
  }`}
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-8 lg:gap-14 xl:gap-20 items-center h-full w-full min-w-0">
    
    <!-- Left Column: 姓名与学术简介 -->
    <div class="md:col-span-6 lg:col-span-6 min-w-0 space-y-4 sm:space-y-6 lg:space-y-8 md:pt-8 lg:pt-16 flex flex-col justify-center">
      
      <!-- Scholar Name (Yi Wang: Josefin Sans 700 Bold) -->
      <h1
        class="text-3xl sm:text-5xl lg:text-[3.25rem] xl:text-[3.75rem] font-bold uppercase tracking-[0.35rem] sm:tracking-[0.5rem] lg:tracking-[0.65rem] text-[#474747] leading-[1.15]"
        style="font-family: 'Josefin Sans', sans-serif;"
      >
        {profileData.name}
      </h1>

      <!-- Bio text (身份与核心方向) -->
      <div
        class="space-y-2 sm:space-y-3 text-[0.875rem] sm:text-[1rem] lg:text-[1.0625rem] text-[#474747] leading-[1.7] sm:leading-[1.85] tracking-[0.02rem] sm:tracking-[0.025rem] text-left"
        style="font-family: 'Montserrat', sans-serif; font-weight: 300;"
      >
        <p>
          I am {profileData.name} ({profileData.chineseName}), a Master's student in Mathematics at the {profileData.institution}.
        </p>
        <p>
          My research interests lie in Arithmetic Geometry, Algebraic Geometry, and Algebraic Number Theory.
        </p>
      </div>

      <!-- Single Email Icon (加大触摸热区) -->
      <div class="pt-1 sm:pt-2 flex items-center">
        <a
          href={profileData.socials.email}
          aria-label="Email"
          class="text-[#636363] hover:text-[#0F0F0F] transition-colors duration-200 inline-block p-1 -m-1"
          title="Email"
        >
          <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current" viewBox="0 0 40 40">
            <path d="M37.5,12.6l-17.5,11.9L2.5,12.6c-.2-.1-.3-.2-.5-.2v-2.7c0-.8.6-1.4,1.4-1.4h33.1c.8,0,1.4.6,1.4,1.4v2.7c-.2,0-.4,0-.5.2ZM19.5,26.3c.2.1.3.2.5.2s.4,0,.5-.2l17.5-11.9v16.9c0,.8-.6,1.4-1.4,1.4H3.4c-.8,0-1.4-.6-1.4-1.4V14.4l17.5,11.9Z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Right Column / 下方展区: 算术调和波 -->
    <div class="md:col-span-6 lg:col-span-6 min-w-0 flex justify-center md:justify-end w-full">
      <div
        id="wave-container-vertical"
        class="w-full max-w-full sm:max-w-[440px] lg:max-w-[480px] xl:max-w-[520px] md:h-[min(580px,68vh)] md:min-h-[350px] flex flex-col justify-between items-center relative select-none"
      >
        <!-- Top Anchor: REGENSBURG -->
        <div class="w-full text-center space-y-0.5 sm:space-y-1.5 relative z-10 flex-shrink-0">
          <div class="text-[0.625rem] sm:text-[0.75rem] font-mono text-[#737373] tracking-[0.14rem] sm:tracking-[0.16rem]">
            49°00′06″ N · 12°05′47″ E
          </div>
          <h3
            class="text-[0.75rem] sm:text-[0.875rem] font-medium tracking-[0.22rem] sm:tracking-[0.28rem] text-[#111111] uppercase"
            style="font-family: 'Montserrat', sans-serif;"
          >
            REGENSBURG
          </h3>
        </div>

        <!-- Middle Vertical Canvas -->
        <div class="relative flex-1 min-h-[100px] sm:min-h-[180px] md:min-h-[220px] w-full my-1 sm:my-2 flex items-center justify-center overflow-hidden">
          <canvas id="geodetic-canvas-vertical" class="w-full h-full block" style="touch-action: none;"></canvas>
        </div>

        <!-- Bottom Anchor: HANGZHOU -->
        <div class="w-full text-center space-y-0.5 sm:space-y-1.5 relative z-10 flex-shrink-0">
          <h3
            class="text-[0.75rem] sm:text-[0.875rem] font-medium tracking-[0.22rem] sm:tracking-[0.28rem] text-[#111111] uppercase"
            style="font-family: 'Montserrat', sans-serif;"
          >
            HANGZHOU
          </h3>
          <div class="text-[0.625rem] sm:text-[0.75rem] font-mono text-[#737373] tracking-[0.14rem] sm:tracking-[0.16rem]">
            30°18′55″ N · 120°21′52″ E
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ================================================================= -->
<!-- SECTION 2: MATHEMATICS (NOTES · EXPOSITION · TEMPLATE)            -->
<!-- ================================================================= -->
<section
  id="mathematics-section"
  class={`page-section max-w-2xl mx-auto w-full space-y-8 sm:space-y-12 pt-9 sm:pt-[clamp(4rem,7.5vh,5.5rem)] pb-8 sm:pb-12 ${
    initialSection === 'mathematics' ? 'active-section block' : 'inactive hidden'
  }`}
>
  <!-- 1. NOTES -->
  <div class="space-y-4 sm:space-y-5.5 pt-1 sm:pt-2">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        NOTES
      </h3>
    </div>
    <div class="space-y-3.5 sm:space-y-4.5 text-left">
      {notesData.map((item) => (
        <article>
          <h4 class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5]">
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-[#333333] hover:text-black underline underline-offset-4 decoration-[#D1D1D1] hover:decoration-black transition-colors duration-200"
              style="font-family: 'Montserrat', sans-serif;"
            >
              {item.title}
            </a>
          </h4>
        </article>
      ))}
    </div>
  </div>

  <!-- 2. EXPOSITION -->
  <div class="space-y-4 sm:space-y-5.5 pt-2.5 sm:pt-3.5">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        EXPOSITION
      </h3>
    </div>
    <div class="space-y-3.5 sm:space-y-4.5 text-left">
      {expositionData.map((item) => (
        <article class="space-y-1">
          <h4
            class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5] font-bold text-[#333333]"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {item.title}
          </h4>
          <p
            class="text-[0.75rem] sm:text-[0.8125rem] text-[#888888] font-light tracking-[0.02rem]"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {item.type} · {item.year}
          </p>
        </article>
      ))}
    </div>
  </div>

  <!-- 3. TEMPLATE -->
  <div class="space-y-4 sm:space-y-5.5 pt-2.5 sm:pt-3.5">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        TEMPLATE
      </h3>
    </div>
    <div class="space-y-3.5 sm:space-y-4.5 text-left">
      {templateData.map((item) => (
        <article class="space-y-1">
          <h4
            class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5] font-bold text-[#333333]"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {item.title}
          </h4>
          <p
            class="text-[0.75rem] sm:text-[0.8125rem] text-[#888888] font-light tracking-[0.02rem] flex items-center gap-2 flex-wrap"
            style="font-family: 'Montserrat', sans-serif;"
          >
            <span>{item.type}</span>
            <span class="text-[#D1D1D1]">·</span>
            <a
              href={item.previewUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#555555] hover:text-black underline underline-offset-4 decoration-[#CCCCCC] hover:decoration-black transition-colors duration-200 py-1"
            >
              Preview
            </a>
            <span class="text-[#D1D1D1]">·</span>
            <a
              href={item.sourceUrl}
              download
              class="text-[#555555] hover:text-black underline underline-offset-4 decoration-[#CCCCCC] hover:decoration-black transition-colors duration-200 py-1"
            >
              Source
            </a>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ================================================================= -->
<!-- SECTION 3: MARGINALIA (PROJECT & INTERESTS)                       -->
<!-- ================================================================= -->
<section
  id="marginalia-section"
  class={`page-section max-w-2xl mx-auto w-full space-y-8 sm:space-y-12 pt-9 sm:pt-[clamp(4rem,7.5vh,5.5rem)] pb-8 sm:pb-12 ${
    initialSection === 'marginalia' ? 'active-section block' : 'inactive hidden'
  }`}
>
  <!-- 1. PROJECT -->
  <div class="space-y-4 sm:space-y-5.5 pt-1 sm:pt-2">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        PROJECT
      </h3>
    </div>
    <div class="space-y-3.5 sm:space-y-4.5 text-left">
      <article>
        <h4 class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5]">
          <a
            href={marginaliaData.project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-[#333333] hover:text-black underline underline-offset-4 decoration-[#D1D1D1] hover:decoration-black transition-colors duration-200"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {marginaliaData.project.title}
          </a>
        </h4>
      </article>
    </div>
  </div>

  <!-- 2. INTERESTS (Scheme B Split Stage + Scheme C Tactile Dynamics) -->
  <div class="space-y-4 sm:space-y-5.5 pt-2.5 sm:pt-3.5">
    <div class="space-y-1">
      <h3
        class="text-[0.75rem] sm:text-[0.8125rem] font-bold uppercase tracking-[0.25rem] text-[#888888]"
        style="font-family: 'Montserrat', sans-serif;"
      >
        INTERESTS
      </h3>
    </div>

    <!-- Split Stage Grid: Left Titles + Right Showcase Stage -->
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 sm:gap-8 items-start">
      <!-- Left Column: Categories List -->
      <div class="stage-navigation sm:col-span-4 space-y-4 sm:space-y-5.5 text-left">
        {marginaliaData.interests.map((item, idx) => (
          <article>
            <h4 class="text-[0.875rem] sm:text-[0.9375rem] leading-[1.5]">
              <a
                href={item.href}
                class={`stage-trigger font-bold transition-colors duration-200 block ${
                  idx === 0
                    ? 'active-stage-trigger text-black'
                    : 'text-[#666666] hover:text-black'
                }`}
                data-stage-id={item.id}
                aria-controls={`stage-panel-${item.id}`}
                aria-current={idx === 0 ? "true" : undefined}
                style="font-family: 'Montserrat', sans-serif;"
              >
                {item.title}
              </a>
            </h4>
          </article>
        ))}
      </div>

      <!-- Right Column: Interactive Stage (Distinct Physical Mediums, Elevated Level with Top Title) -->
      <div class="marginalia-stage sm:col-span-8 relative min-h-[250px] sm:min-h-[216px] flex items-start justify-center">
        
        <!-- Photography: two archival prints. -->
        <div id="stage-panel-photography" class="stage-panel" data-active="true" aria-hidden="false">
          <a href="/marginalia/photography" aria-label="Explore Photography" class="stage-art-link">
            <div class="photo-container" aria-hidden="true">
              <div class="photo-secondary">
                <img src={archivePrint.thumbnailUrl} alt="" width={archivePrint.width} height={archivePrint.height} loading="lazy" decoding="async" />
                <span>TOKYO · FIREWORKS</span>
              </div>
              <div class="photo-primary">
                <img src={lakePrint.thumbnailUrl} alt="" width={lakePrint.width} height={lakePrint.height} loading="lazy" decoding="async" />
                <span>WEST LAKE · MORNING MIST</span>
              </div>
            </div>
          </a>
        </div>

        <!-- Cinema: two identical runs of flat film make one seamless loop. -->
        <div id="stage-panel-cinema" class="stage-panel" inert aria-hidden="true">
          <a href="/marginalia/cinema" aria-label="Explore Screen" class="stage-art-link">
            <div class="cinema-scene" aria-hidden="true">
              <div class="cinema-strip">
                <div class="cinema-track">
                  {[...cinemaFrames, ...cinemaFrames].map(film => <div class="cinema-frame"><img src={film.posterUrl} alt="" width="82" height="108" loading="lazy" decoding="async" /></div>)}
                </div>
                <div class="cinema-glow"></div>
              </div>
            </div>
          </a>
        </div>

        <!-- Literature: the unmodified ZineJS engine in a reusable preview. -->
        <div id="stage-panel-literature" class="stage-panel" inert aria-hidden="true">
          <a href="/marginalia/literature" class="stage-art-link" aria-label="Explore Literature — 百年孤独">
            <LiteratureBook />
          </a>
        </div>

        <!-- 4. Music Panel: Classical Vinyl LP (Smooth Draw-Out & Grooved Spin) (已向左平移居中) -->
        <div
          id="stage-panel-music"
          class="stage-panel" inert aria-hidden="true"
        >
          <a
            href="/marginalia/music"
            class="relative w-full h-full flex items-start justify-center pt-2 sm:pt-2.5 cursor-pointer select-none overflow-visible"
            aria-label="Explore Music"
          >
            <div aria-hidden="true" class="music-container relative w-[280px] sm:w-[330px] h-[210px] sm:h-[240px] flex items-center justify-start pl-2 sm:pl-4 -translate-x-8 sm:-translate-x-12">
              
              <!-- Black Vinyl Record Wrap (Glides horizontally out of the sleeve) -->
              <div class="vinyl-disc-wrap absolute left-2 sm:left-4 z-0 w-[180px] sm:w-[210px] h-[180px] sm:h-[210px] flex items-center justify-center">
                <!-- Vinyl Disc Inner (Rotates gently once drawn out) -->
                <div class="vinyl-disc-inner w-full h-full rounded-full border-2 border-[#252525] shadow-[0_8px_28px_rgba(0,0,0,0.35)] flex items-center justify-center relative overflow-hidden" style="background: radial-gradient(circle at center, #1a1a1a 20%, #0c0c0c 100%);">
                  <!-- Vinyl Concentric Sound Grooves -->
                  <div class="w-[84%] h-[84%] rounded-full border border-white/5 flex items-center justify-center relative z-10">
                    <div class="w-[70%] h-[70%] rounded-full border border-white/5 flex items-center justify-center">
                      <!-- Center Paper Label -->
                      <div class="w-[36%] h-[36%] rounded-full bg-[#C89B67] border border-white/20 flex flex-col items-center justify-center text-center shadow-inner">
                        <div class="w-2.5 sm:w-3 h-2.5 sm:h-3 rounded-full bg-[#111111] border border-white/30 mb-0.5"></div>
                        <span class="text-[0.32rem] sm:text-[0.38rem] font-mono text-[#2B1B0E] font-bold tracking-tighter">MUSIC</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="vinyl-sleeve">
                <img src={musicCover.coverUrl} alt="" width="220" height="220" loading="lazy" decoding="async" />
              </div>
            </div>
          </a>
        </div>

        <!-- 5. Table Tennis Panel: Authentic Butterfly Viscaria FL Blade & Topspin Bounce (纯粹球拍与球碰撞旋转) -->
        <div
          id="stage-panel-table-tennis"
          class="stage-panel" inert aria-hidden="true"
        >
          <a
            href="/marginalia/table-tennis"
            class="relative w-full h-full flex items-start justify-center pt-1 sm:pt-2 cursor-pointer select-none overflow-visible"
            aria-label="Explore Table Tennis"
          >
            <div aria-hidden="true" class="tt-container relative w-[320px] sm:w-[380px] h-[220px] sm:h-[250px] flex items-center justify-center">
              
              <!-- Subtle Court Ground Shadow -->
              <div class="tt-court-shadow absolute bottom-3 w-[190px] h-[18px] bg-black/20 rounded-full blur-md pointer-events-none translate-x-2"></div>

              <!-- Authentic Butterfly Viscaria FL Table Tennis Racket (3D Layered Physical Anatomy) -->
              <div class="tt-racket-assembly relative w-[160px] sm:w-[172px] h-[230px] sm:h-[246px] select-none" style="transform-style: preserve-3d;">
                
                <svg class="racket-layer racket-back" viewBox="0 0 160 230"><path d={racketOutline} fill="#282725" /></svg>
                {Array.from({ length: 10 }, (_, layer) => <svg class="racket-layer racket-wood" viewBox="0 0 160 230" style={`transform: translateZ(${layer - 6}px)`}><path d={racketOutline} fill={['#a78660', '#cfb18a', '#b99870', '#dac09b', '#947655'][layer % 5]} stroke={['#a78660', '#cfb18a', '#b99870', '#dac09b', '#947655'][layer % 5]} stroke-width="0.45" stroke-linejoin="round" /></svg>)}
                {Array.from({ length: 8 }, (_, layer) => <svg class="racket-layer" viewBox="0 0 160 230" style={`transform: translateZ(${layer + 4}px)`}><path d={handleOutline} fill={layer % 3 === 0 ? '#87603e' : '#b18a5d'} /></svg>)}
                <svg class="racket-layer racket-rubber" viewBox="0 0 160 230">
                  <defs><linearGradient id="racket-rubber" x2="0.8" y2="1"><stop stop-color="#c93f42" /><stop offset="1" stop-color="#9b2029" /></linearGradient></defs>
                  <path d={rubberOutline} fill="url(#racket-rubber)" stroke="#873039" stroke-width="0.8" stroke-linejoin="round" />
                  <path d="M15 65 C21 31 47 11 80 11 C108 11 130 27 142 52" fill="none" stroke="#efaaa0" stroke-opacity="0.25" stroke-width="0.7" stroke-linecap="round" />
                  <path d="M34 136 Q79 159 126 134" fill="none" stroke="#ffffff18" stroke-width="0.8" />
                </svg>
                <svg class="racket-layer racket-handle" viewBox="0 0 160 230">
                  <defs><linearGradient id="racket-handle" x2="1" y2="0"><stop stop-color="#9a6f43" /><stop offset="0.45" stop-color="#d8bb8c" /><stop offset="1" stop-color="#a17b4c" /></linearGradient></defs>
                  <path d={handleOutline} fill="url(#racket-handle)" stroke="#856039" stroke-width="1" />
                  <path d="M72 152 Q78 179 70 226 M87 152 Q81 179 90 226" fill="none" stroke="#344554" stroke-width="3" />
                  <path d="M77 154 Q81 185 77 226 M82 154 Q79 185 83 226" fill="none" stroke="#785932" stroke-width="0.7" opacity="0.6" />
                  <rect x="75" y="209" width="10" height="9" rx="2" fill="#293842" stroke="#bca880" stroke-width="0.7" />
                </svg>

                <!-- Contact shadow -->
                <div class="tt-rubber-ball-shadow"></div>

                <!-- Sweet Spot Impact Ripple Pulse -->
                <div class="tt-impact-ripple"></div>

                <!-- 40+ 3-Star Poly Ball (Hovering with Clear Air Gap & Dynamic 3D Topspin Bounce) -->
                <div class="tt-ball-rig">
                  <div class="tt-ball-sphere">
                  </div>
                </div>

              </div>

            </div>
          </a>
        </div>

        <!-- 6. Games Panel: Classic White 1st-Gen Game Boy Handheld (情怀复古白色初代掌机) (已向左平移居中) -->
        <div
          id="stage-panel-games"
          class="stage-panel" inert aria-hidden="true"
        >
          <a
            href="/marginalia/games"
            class="relative w-full h-full flex items-start justify-center pt-0 sm:pt-0 cursor-pointer select-none overflow-visible"
            aria-label="Explore Games"
          >
            <div aria-hidden="true" class="gameboy-stage relative w-[290px] sm:w-[330px] h-[225px] sm:h-[255px] flex items-center justify-center -translate-x-8 sm:-translate-x-10">

              
              <!-- Subtle Ground Shadow -->
              <div class="gameboy-ground-shadow absolute -bottom-2 w-[160px] sm:w-[176px] h-6 bg-black/35 rounded-full blur-md pointer-events-none"></div>

              <!-- Classic White Game Boy DMG-01 Handheld Chassis (3D Solid Body) -->
              <div class="gameboy-white relative z-10 w-[170px] sm:w-[186px] h-[238px] sm:h-[258px] select-none" style="transform-style: preserve-3d;">
                
                <div class="gameboy-back"></div>
                <div class="gameboy-side-right"><div class="gameboy-volume"></div></div>
                <div class="gameboy-side-left"></div>
                <div class="gameboy-side-top"></div>
                <div class="gameboy-side-bottom"></div>
                <div class="gameboy-side-corner"></div>

                <svg class="gameboy-circuit" viewBox="0 0 186 258" aria-hidden="true">
                  <rect x="12" y="15" width="162" height="226" rx="13" fill="#777d7e" />
                  <g fill="none" stroke="#c6cdcb" stroke-width="1" opacity="0.6">
                    <path d="M24 129H78V171H136V223 M30 134H72V180H124V236 M157 110V149H107V211H50 M163 115V156H115V202H35 M34 220H77V197H153" />
                    <circle cx="46" cy="174" r="25" /><circle cx="141" cy="167" r="17" />
                  </g>
                  <rect x="83" y="144" width="18" height="23" rx="2" fill="#303536" />
