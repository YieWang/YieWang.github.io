---
import { publicationsData } from '../data/publications';

const bibtexMap = Object.fromEntries(
  publicationsData.map((pub) => [pub.id, pub.bibtex])
);
---

<!-- BibTeX Modal with Soft Rounded Corners & Natural Paper Shadow -->
<div
  id="bibtex-modal"
  class="fixed inset-0 z-50 bg-stone-900/40 backdrop-blur-xs hidden items-center justify-center p-4 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="bibtex-title"
>
  <div class="w-full max-w-lg rounded-2xl bg-white border border-stone-200/90 p-6 shadow-xl space-y-4">
    <div class="flex items-center justify-between pb-2 border-b border-stone-200">
      <h3 id="bibtex-title" class="text-sm font-bold text-stone-900 font-serif">
        BibTeX 引用条目
      </h3>
      <button
        id="close-bibtex-btn"
        class="text-stone-400 hover:text-stone-700 text-lg p-1 transition rounded-lg"
        aria-label="关闭弹窗"
      >
        ✕
      </button>
    </div>

    <pre
      id="bibtex-code-content"
      class="p-4 rounded-xl bg-stone-50 text-xs font-mono text-stone-800 overflow-x-auto border border-stone-200/80 leading-relaxed max-h-60"
    ></pre>

    <div class="flex items-center justify-between pt-2">
      <span id="copy-status" class="text-xs text-emerald-700 font-medium opacity-0 transition-opacity">
        已成功复制到剪贴板！
      </span>
      <div class="flex items-center gap-2">
        <button
          id="close-bibtex-secondary"
          class="px-3.5 py-1.5 rounded-xl text-xs font-medium bg-stone-100 text-stone-700 hover:bg-stone-200 transition"
        >
          关闭
        </button>
        <button
          id="copy-bibtex-btn"
          class="px-3.5 py-1.5 rounded-xl text-xs font-medium bg-stone-900 hover:bg-stone-800 text-white transition flex items-center gap-1.5 shadow-xs"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
          </svg>
          复制 BibTeX
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ bibtexMap }}>
  const modal = document.getElementById('bibtex-modal');
  const codeContent = document.getElementById('bibtex-code-content');
  const copyStatus = document.getElementById('copy-status');
  const closeBtn = document.getElementById('close-bibtex-btn');
  const closeSecondary = document.getElementById('close-bibtex-secondary');
  const copyBtn = document.getElementById('copy-bibtex-btn');

  function openModal(id) {
    if (!modal || !codeContent) return;
    codeContent.textContent = bibtexMap[id] || '';
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    if (copyStatus) copyStatus.style.opacity = '0';
  }

  document.querySelectorAll('.bibtex-trigger').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const id = target.getAttribute('data-bibtex-id');
      if (id) openModal(id);
    });
  });

  closeBtn?.addEventListener('click', closeModal);
  closeSecondary?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  copyBtn?.addEventListener('click', () => {
    if (!codeContent?.textContent) return;
    navigator.clipboard.writeText(codeContent.textContent).then(() => {
      if (copyStatus) {
        copyStatus.style.opacity = '1';
        setTimeout(() => {
          copyStatus.style.opacity = '0';
        }, 2500);
      }
    });
  });
</script>
