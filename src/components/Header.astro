---
interface Props {
  activeTab?: 'home' | 'mathematics' | 'marginalia';
}

const { activeTab = 'home' } = Astro.props;
---

<div class="h-[51px] sm:h-[94px] md:h-[98px] shrink-0" aria-hidden="true"></div>
<header id="header" class="fixed inset-x-0 top-0 z-40 bg-white pt-2 sm:pt-7 md:pt-8">
  <nav class="py-1 w-full max-w-[72rem] mx-auto px-4 sm:px-10 md:px-16">
    <ul class="flex items-center justify-center w-full mx-auto gap-5 sm:gap-8 md:gap-11 flex-nowrap" role="tablist">
      <li>
        <a
          href="/"
          id="nav-home"
          data-target="home"
          data-title="Home"
          class={`nav-link uppercase text-[0.625rem] sm:text-[0.75rem] tracking-[0.08em] sm:tracking-[0.25rem] px-1 sm:px-2 py-1.5 sm:py-2 transition-colors duration-200 cursor-pointer no-underline inline-flex ${
            activeTab === 'home'
              ? 'active-nav text-black font-bold'
              : 'text-[#737373] hover:text-black font-medium'
          }`}
          style="font-family: 'Montserrat', sans-serif;"
        >
          Home
        </a>
      </li>
      <li>
        <a
          href="/mathematics/"
          id="nav-mathematics"
          data-target="mathematics"
          data-title="Mathematics"
          class={`nav-link uppercase text-[0.625rem] sm:text-[0.75rem] tracking-[0.08em] sm:tracking-[0.25rem] px-1 sm:px-2 py-1.5 sm:py-2 transition-colors duration-200 cursor-pointer no-underline inline-flex ${
            activeTab === 'mathematics'
              ? 'active-nav text-black font-bold'
              : 'text-[#737373] hover:text-black font-medium'
          }`}
          style="font-family: 'Montserrat', sans-serif;"
        >
          Mathematics
        </a>
      </li>
      <li>
        <a
          href="/marginalia/"
          id="nav-marginalia"
          data-target="marginalia"
          data-title="Marginalia"
          class={`nav-link uppercase text-[0.625rem] sm:text-[0.75rem] tracking-[0.08em] sm:tracking-[0.25rem] px-1 sm:px-2 py-1.5 sm:py-2 transition-colors duration-200 cursor-pointer no-underline inline-flex ${
            activeTab === 'marginalia'
              ? 'active-nav text-black font-bold'
              : 'text-[#737373] hover:text-black font-medium'
          }`}
          style="font-family: 'Montserrat', sans-serif;"
        >
          Marginalia
        </a>
      </li>
      <li>
        <!-- CV 暂停开放；恢复时改回链接，使用 profileData.socials.cvUrl。 -->
        <span
          aria-disabled="true"
          id="nav-cv"
          data-title="CV"
          class="nav-link text-[#737373] cursor-default font-medium uppercase text-[0.625rem] sm:text-[0.75rem] tracking-[0.08em] sm:tracking-[0.25rem] px-1 sm:px-2 py-1.5 sm:py-2 transition-colors duration-200 no-underline inline-flex"
          style="font-family: 'Montserrat', sans-serif;"
        >
          CV
        </span>
      </li>
    </ul>
  </nav>
</header>

<style>
  /* 解决导航文字加粗时宽度撑开导致整体居中导航栏水平抖动的问题 (Zero-Shift Bold Placeholder) */
  .nav-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .nav-link::after {
    content: attr(data-title);
    font-weight: 700;
    height: 0;
    visibility: hidden;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
  }
</style>
