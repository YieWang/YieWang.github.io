---
import { profileData } from '../data/profile';

const currentYear = new Date().getFullYear();
---

<footer
  id="footer"
  class="w-full max-w-[72rem] mx-auto px-4 sm:px-10 md:px-16 pb-8 sm:pb-3 pt-1 flex-shrink-0"
  style="padding-bottom: max(2rem, calc(0.75rem + env(safe-area-inset-bottom)));"
>
  <p
    class="text-center text-[0.6875rem] sm:text-[0.7rem] text-[#888888] leading-[1.8] font-light tracking-[0.05rem]"
    style="font-family: 'Montserrat', sans-serif;"
  >
    © {currentYear} {profileData.name}.
  </p>
</footer>
