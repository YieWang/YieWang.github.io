---
import type { MusicArtist } from '../data/music';
interface Props { artists: MusicArtist[] }
const { artists } = Astro.props;
---

<nav class="artist-rail" aria-label="Artists">
  <div id="artist-wheel">
    {artists.map((artist, index) => (
      <a href={`#section-${artist.id}`} class="artist-row" data-artist={artist.id}
        aria-current={index === 0 ? 'true' : undefined}>
        {artist.avatarUrl ? <img src={artist.avatarUrl} alt="" width="48" height="48" loading="lazy" /> : <span class="artist-initial" aria-hidden="true">{Array.from(artist.displayName)[0]}</span>}
        <span>{artist.displayName}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .artist-rail { position: fixed; z-index: 20; left: 24px; top: 50%; transform: translateY(-50%); width: var(--artist-rail-width); }
  #artist-wheel { height: 360px; overflow-y: auto; padding-block: 144px; box-sizing: border-box; scroll-snap-type: y mandatory; overscroll-behavior: contain; scrollbar-width: none; mask-image: linear-gradient(transparent, black 25%, black 75%, transparent); }
  #artist-wheel::-webkit-scrollbar { display: none; }
  .artist-row { height: 72px; display: flex; align-items: center; gap: 12px; padding: 0 6px; scroll-snap-align: center; color: #777; text-decoration: none; opacity: .35; transition: opacity 220ms, color 220ms; cursor: default; }
  .artist-row img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .artist-initial { width: 48px; height: 48px; border-radius: 50%; background: #eee; display: grid; place-items: center; flex-shrink: 0; }
  .artist-row span { font-size: .78rem; line-height: 1.4; font-family: 'Montserrat', 'PingFang SC', sans-serif; }
  .artist-row[aria-current] { opacity: 1; color: #111; font-weight: 700; }
  .artist-row:focus-visible { outline: none; }
  @media (max-width: 639px) {
    .artist-rail { left: 6px; }
    .artist-row { gap: 7px; padding-inline: 2px; }
    .artist-row img, .artist-initial { width: 34px; height: 34px; }
    .artist-row span { font-size: .65rem; }
  }
</style>

<script>
  const rail = document.getElementById('artist-wheel')!;
  const rows = Array.from(rail.querySelectorAll<HTMLAnchorElement>('.artist-row'));
  const sections = rows.map(row => document.getElementById(`section-${row.dataset.artist}`)!);
  let driver: 'page' | 'rail' | 'jump' = 'page';
  let selected = -1;
  let railTimer: ReturnType<typeof setTimeout>;
  let pageTimer: ReturnType<typeof setTimeout>;
  let frame = 0;
  const motion = () => matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';

  function highlight(index: number, center = true) {
    if (!rows[index] || index === selected) return;
    selected = index;
    rows.forEach((row, i) => i === index ? row.setAttribute('aria-current', 'true') : row.removeAttribute('aria-current'));
    if (center) rail.scrollTo({ top: rows[index].offsetTop - rows[0].offsetTop, behavior: motion() });
  }

  function followPage() {
    if (driver !== 'page') return;
    if (scrollY <= 1) { highlight(0); return; }
    let index = 0;
    sections.forEach((section, i) => { if (section.getBoundingClientRect().top <= innerHeight / 2) index = i; });
    highlight(index);
  }

  function finishJump() {
    if (driver !== 'jump') return;
    driver = 'page';
    followPage();
  }

  function jump(index: number) {
    if (!sections[index]) return;
    driver = 'jump';
    clearTimeout(railTimer);
    highlight(index);
    const rect = sections[index].getBoundingClientRect();
    const top = scrollY + rect.top - innerHeight / 2 + Math.min(rect.height / 2, innerHeight / 2 - 80);
    window.scrollTo({ top: Math.max(0, top), behavior: motion() });
    clearTimeout(pageTimer);
    pageTimer = setTimeout(finishJump, 200);
  }

  function finishRail() {
    if (driver !== 'rail') return;
    jump(Math.max(0, Math.min(rows.length - 1, Math.round(rail.scrollTop / 72))));
  }

  rail.addEventListener('wheel', () => { driver = 'rail'; clearTimeout(pageTimer); }, { passive: true });
  rail.addEventListener('pointerdown', () => { driver = 'rail'; clearTimeout(pageTimer); });
  rail.addEventListener('scroll', () => {
    if (driver !== 'rail') return;
    clearTimeout(railTimer);
    railTimer = setTimeout(finishRail, 160);
  }, { passive: true });
  rail.addEventListener('scrollend', finishRail);
  rows.forEach((row, index) => row.addEventListener('click', event => {
    if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
    event.preventDefault();
    jump(index);
  }));
  rail.addEventListener('keydown', event => {
    if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    const index = event.key === 'Home' ? 0 : event.key === 'End' ? rows.length - 1
      : Math.max(0, Math.min(rows.length - 1, selected + (event.key === 'ArrowDown' ? 1 : -1)));
    jump(index);
  });
  const takePageControl = (event: Event) => {
    if (rail.contains(event.target as Node)) return;
    driver = 'page';
    clearTimeout(railTimer);
    clearTimeout(pageTimer);
  };
  window.addEventListener('wheel', takePageControl, { passive: true });
  window.addEventListener('pointerdown', takePageControl, { passive: true });
  window.addEventListener('keydown', takePageControl);
  window.addEventListener('scroll', () => {
    if (driver === 'jump') {
      clearTimeout(pageTimer);
      pageTimer = setTimeout(finishJump, 160);
    } else {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(followPage);
    }
  }, { passive: true });
  window.addEventListener('scrollend', event => { if (event.target === document) finishJump(); });
  window.addEventListener('resize', followPage);
  followPage();
</script>
