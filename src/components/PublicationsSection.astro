---
import { publicationsData } from '../data/publications';
---

<section id="publications" class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-stone-200 pb-2">
    <h2 class="text-xl font-bold tracking-tight text-stone-900 font-serif">
      代表性学术成果 (Selected Publications)
    </h2>
    <span class="text-xs text-stone-500">* 为共同第一作者，粗体为本人姓名</span>
  </div>

  <div class="space-y-5">
    {publicationsData.map((pub) => (
      <article class="p-6 rounded-xl bg-white border border-stone-200 shadow-xs hover:border-stone-300 transition duration-200 space-y-3">
        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-2">
          {pub.badge && (
            <span class="px-2.5 py-0.5 rounded text-xs font-medium bg-navy-50 text-navy-900 border border-navy-200">
              {pub.badge}
            </span>
          )}
          {pub.acceptanceRate && (
            <span class="text-xs text-stone-500 font-sans">
              录用率 {pub.acceptanceRate}
            </span>
          )}
        </div>

        <!-- Title -->
        <h3 class="text-lg sm:text-xl font-bold text-stone-900 font-serif leading-snug">
          {pub.title}
        </h3>

        <!-- Authors -->
        <p class="text-sm text-stone-700 leading-normal">
          {pub.authors.map((author, index) => {
            const isMe = author.toLowerCase().includes('yi wang') || author.toLowerCase().includes('wang yi');
            return (
              <span>
                {isMe ? (
                  <strong class="text-stone-900 font-bold underline decoration-stone-300 decoration-1 underline-offset-4">
                    {author}
                  </strong>
                ) : (
                  <span>{author}</span>
                )}
                {index < pub.authors.length - 1 ? ", " : ""}
              </span>
            );
          })}
        </p>

        <!-- Venue & Year -->
        <p class="text-xs text-stone-500 italic font-serif">
          {pub.venue}, {pub.year}
        </p>

        <!-- Abstract -->
        <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
          {pub.abstract}
        </p>

        <!-- Links and Actions -->
        <div class="pt-2 flex flex-wrap items-center gap-2">
          {pub.pdfUrl && (
            <a
              href={pub.pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1 rounded text-xs font-medium bg-stone-100 hover:bg-stone-200 text-stone-800 transition flex items-center gap-1"
            >
              <svg class="w-3.5 h-3.5 text-stone-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
              论文 PDF
            </a>
          )}

          {pub.codeUrl && (
            <a
              href={pub.codeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1 rounded text-xs font-medium bg-stone-100 hover:bg-stone-200 text-stone-800 transition flex items-center gap-1"
            >
              开源代码
            </a>
          )}

          {pub.projectUrl && (
            <a
              href={pub.projectUrl}
              class="px-3 py-1 rounded text-xs font-medium bg-stone-100 hover:bg-stone-200 text-stone-800 transition"
            >
              项目主页
            </a>
          )}

          <button
            type="button"
            data-bibtex-id={pub.id}
            class="bibtex-trigger px-3 py-1 rounded text-xs font-medium bg-stone-100 hover:bg-stone-200 text-navy-900 transition flex items-center gap-1 cursor-pointer"
          >
            BibTeX 引用
          </button>
        </div>
      </article>
    ))}
  </div>
</section>
