---
import { newsData } from '../data/news';
---

<section id="news" class="space-y-4">
  <div class="flex items-center justify-between border-b border-stone-200 pb-2">
    <h2 class="text-xl font-bold tracking-tight text-stone-900 font-serif">
      最新动态 (Recent News)
    </h2>
    <span class="text-xs text-stone-400">持续更新</span>
  </div>

  <div class="divide-y divide-stone-100 bg-white rounded-xl border border-stone-200/80 p-1 shadow-xs">
    {newsData.map((item) => (
      <div class="py-3 px-4 flex items-start gap-4 hover:bg-stone-50/70 transition rounded-lg">
        <span class="text-xs font-medium text-stone-500 font-mono shrink-0 mt-0.5">
          {item.date}
        </span>
        <p class="text-sm text-stone-700 leading-relaxed">
          {item.content}{" "}
          {item.highlightText && (
            <strong class="text-navy-900 font-semibold">{item.highlightText}</strong>
          )}
        </p>
      </div>
    ))}
  </div>
</section>
