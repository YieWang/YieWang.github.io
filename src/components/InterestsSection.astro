---
import { interestsData } from '../data/interests';
---

<section id="interests" class="space-y-6">
  <div class="border-b border-stone-200 pb-2">
    <h2 class="text-xl font-bold tracking-tight text-stone-900 font-serif">
      生活札记与个人兴趣 (Life & Beyond Research)
    </h2>
    <p class="text-xs text-stone-500 mt-1">
      学术是理解世界的一种路径，生活与观察是另一座灯塔。
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <!-- 1. Photography -->
    <div class="p-6 rounded-xl bg-white border border-stone-200 shadow-xs space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-stone-900 flex items-center gap-1.5">
          📷 胶片与光影记录 (Photography)
        </h3>
        <span class="text-xs text-stone-400 font-serif">{interestsData.photography.device}</span>
      </div>

      <div class="grid grid-cols-3 gap-2 py-1">
        {interestsData.photography.items.map((item) => (
          <div class="h-24 rounded-lg bg-stone-100 border border-stone-200 flex flex-col items-center justify-center text-center p-1.5 hover:bg-stone-200/60 transition">
            <span class="text-[11px] text-stone-800 font-medium">{item.title}</span>
            <span class="text-[9px] text-stone-400 mt-0.5">{item.location} · {item.tag}</span>
          </div>
        ))}
      </div>

      <p class="text-xs text-stone-600 leading-relaxed">
        {interestsData.photography.description}
      </p>
    </div>

    <!-- 2. Reading & Bookshelf -->
    <div class="p-6 rounded-xl bg-white border border-stone-200 shadow-xs space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-stone-900 flex items-center gap-1.5">
          📚 案头在读 (Reading & Philosophy)
        </h3>
        <span class="text-xs text-stone-400">{interestsData.reading.period}</span>
      </div>

      <div class="p-3.5 rounded-lg bg-stone-50 border border-stone-200/80 space-y-1">
        <div class="text-sm font-semibold text-stone-900 font-serif">
          {interestsData.reading.currentBook.title}
        </div>
        <div class="text-xs text-stone-500">
          {interestsData.reading.currentBook.author} · <span class="text-emerald-700 font-medium">{interestsData.reading.currentBook.status}</span>
        </div>
        <div class="text-xs text-stone-600 pt-1 leading-relaxed">
          {interestsData.reading.currentBook.comment}
        </div>
      </div>

      <p class="text-xs text-stone-500 italic font-serif">
        {interestsData.reading.quote}
      </p>
    </div>

    <!-- 3. Routine -->
    <div class="p-6 rounded-xl bg-white border border-stone-200 shadow-xs space-y-3">
      <h3 class="text-sm font-semibold text-stone-900 flex items-center gap-1.5">
        🏃 生活步调 (Routine)
      </h3>
      <div class="space-y-2 text-xs text-stone-700">
        {interestsData.routine.map((item, index) => (
          <div class={`flex justify-between py-1.5 ${index < interestsData.routine.length - 1 ? 'border-b border-stone-100' : ''}`}>
            <span class="text-stone-500">{item.label}</span>
            <span class="font-medium text-stone-900">{item.value}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- 4. Reflections / Short Essays -->
    <div class="p-6 rounded-xl bg-white border border-stone-200 shadow-xs space-y-3">
      <h3 class="text-sm font-semibold text-stone-900 flex items-center gap-1.5">
        ✍️ 札记小思 (Reflections)
      </h3>
      <div class="space-y-2.5">
        {interestsData.reflections.map((ref) => (
          <div class="p-3 rounded-lg bg-stone-50 border border-stone-200/70 hover:border-stone-300 transition">
            <h4 class="text-xs font-semibold text-stone-900">
              {ref.title}
            </h4>
            <p class="text-xs text-stone-600 mt-1 line-clamp-2 leading-relaxed">
              {ref.summary}
            </p>
            <div class="text-[10px] text-stone-400 font-mono mt-1.5">
              {ref.date} · {ref.readTime}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
