---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  fullWidth?: boolean;
  zeroScroll?: boolean;
}

const {
  title = "Yi Wang",
  description = "Official website of Yi Wang (王怡), Master's student in Mathematics at the University of Regensburg.",
  isHome = false,
  fullWidth = false,
  zeroScroll = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN" class={isHome || zeroScroll ? "is-home" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Local Self-Hosted Fonts: Josefin Sans (700) & Montserrat (Variable 100-900) -->
    <link rel="preload" href="/fonts/josefin-sans-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- 样式自愈防护：若本地缓存的 HTML 请求了旧部署已删除的 CSS 导致 404，自动刷新拉取最新页面与样式表 -->
    <script is:inline>
      window.addEventListener('error', function (e) {
        var t = e.target;
        if (t && t.tagName === 'LINK' && t.rel === 'stylesheet') {
          if (!sessionStorage.getItem('css_reload_guard')) {
            sessionStorage.setItem('css_reload_guard', '1');
            window.location.reload();
          }
        }
      }, true);
      window.addEventListener('DOMContentLoaded', function () {
        sessionStorage.removeItem('css_reload_guard');
      });
    </script>
  </head>
  <body class={`bg-white text-[#474747] min-h-screen antialiased selection:bg-stone-200 ${isHome || zeroScroll ? "is-home" : ""}`}>
    <div
      id="site-wrapper"
      class="min-h-screen bg-white text-[#474747] flex flex-col justify-between selection:bg-[#E5E5E5] selection:text-black w-full max-w-full"
    >
      <main class={`w-full mx-auto pb-1 min-h-0 flex-grow flex flex-col justify-start ${
        fullWidth
          ? 'max-w-[100vw] px-2 sm:px-4 md:px-6'
          : 'max-w-[72rem] px-4 sm:px-10 md:px-16'
      }`}>
        <slot />
      </main>
      {!zeroScroll ? (
        <Footer />
      ) : (
        <div class="block md:hidden w-full">
          <Footer />
        </div>
      )}
    </div>
    {/^\/marginalia\/(screen|music|literature|games)\/?$/.test(Astro.url.pathname) && <BackToTop />}
    {import.meta.env.DEV && process.env.HOMEPAGE_EDITOR === '1' && (
      <script is:inline type="module" src="/__editor/ui.js"></script>
    )}
  </body>
</html>

<style is:global>

  /* 桌面端单屏零滚动：首页、两个主栏目及单屏画廊 */
  @media (min-width: 768px) {
    body.is-home {
      overflow: hidden;
      height: 100vh;
      overscroll-behavior: none;
    }
    body.is-home #site-wrapper {
      height: 100vh;
      max-height: 100vh;
      overflow: hidden;
      overscroll-behavior: none;
    }
  }

  /* 其他独立内容页保留自然滚动 */
  body:not(.is-home) {
    overflow-y: auto;
    min-height: 100dvh;
  }
  body:not(.is-home) #site-wrapper {
    height: auto;
    min-height: 100dvh;
    overflow: visible;
  }

  /* 移动端学术画卷流 (Mobile Academic Scroll Flow) */
  @media (max-width: 767px), (hover: none) and (pointer: coarse) {
    body.is-home {
      overflow-y: auto;
      height: auto;
      min-height: 100dvh;
    }
    body.is-home #site-wrapper {
      height: auto;
      max-height: none;
      min-height: 100dvh;
      overflow: visible;
    }
  }

  /* 移动端导航栏：在 640px 以下严格居中，纯净空白间距，确保 4 项完整陈列且两端对称 */
  @media (max-width: 639px) {
    #header nav ul {
      width: 100% !important;
      margin-left: auto !important;
      margin-right: auto !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 1.15rem !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    #header nav ul a {
      font-size: 0.62rem !important;
      letter-spacing: 0.06rem !important;
      padding: 0.375rem 0.2rem !important;
    }
  }
</style>
