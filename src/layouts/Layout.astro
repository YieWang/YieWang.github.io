---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Yi Wang (王怡) – Pure Mathematics",
  description = "Official academic homepage of Yi Wang (王怡), Master's student in Mathematics at the University of Regensburg."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎓</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Julian Perilla 1:1 Google Fonts: Josefin Sans & Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?display=swap&family=Josefin+Sans:ital,wght@0,700;1,700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,700;0,900;1,300;1,400;1,500;1,700;1,900"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-[#474747] min-h-screen antialiased selection:bg-stone-200">
    <slot />
  </body>
</html>
